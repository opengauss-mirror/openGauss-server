create database s_test_pg_identity_dump_restore dbcompatibility 'D';
create database s_test_pg_identity_dump_restore_1 dbcompatibility 'D';
\c s_test_pg_identity_dump_restore_1
create extension shark;
\c s_test_pg_identity_dump_restore
create extension shark;
create schema s_test_pg_identity_dump_restore;
set current_schema = s_test_pg_identity_dump_restore;
CREATE TABLE test_t1 (a int GENERATED ALWAYS AS IDENTITY (START WITH 20 INCREMENT 2 NOMAXVALUE NOMINVALUE), b text);
NOTICE:  CREATE TABLE will create implicit sequence "test_t1_a_seq" for serial column "test_t1.a"
CREATE TABLE test_t2 (a int GENERATED BY DEFAULT AS IDENTITY ( START 10 INCREMENT 1 MAXVALUE 2222), b text);
NOTICE:  CREATE TABLE will create implicit sequence "test_t2_a_seq" for serial column "test_t2.a"
ALTER TABLE test_t2 ADD COLUMN c int GENERATED ALWAYS AS IDENTITY (START 20 NOMAXVALUE NOMINVALUE NOCYCLE); -- success
NOTICE:  ALTER TABLE will create implicit sequence "test_t2_c_seq" for serial column "test_t2.c"
ALTER TABLE test_t2 ALTER COLUMN c SET GENERATED BY DEFAULT SET INCREMENT BY 2 SET START WITH 100 RESTART;
CREATE TABLE book(bookId int IDENTITY, bookname NVARCHAR(50), author NVARCHAR(50));
NOTICE:  CREATE TABLE will create implicit sequence "book_bookid_seq_identity" for serial column "book.bookid"
INSERT INTO test_t1 DEFAULT VALUES;
INSERT INTO test_t1 DEFAULT VALUES;
INSERT INTO test_t2 DEFAULT VALUES;
INSERT INTO test_t2 DEFAULT VALUES;
INSERT INTO book VALUES('book1','author1'),('book2','author2');
INSERT INTO book(bookname,author) VALUES('book3','author3'),('book4','author4');
