BEGIN;
CREATE SCHEMA cfs_upgrade_guard;

-- Create a compressed table to trigger the upgrade guard.
CREATE TABLE cfs_upgrade_guard.compressed_table(id INTEGER) WITH (compresstype = 2);
SAVEPOINT maindb_guard;
\set ECHO none
\i @abs_srcdir@/../../include/catalog/upgrade_sql/upgrade_catalog_maindb/upgrade_catalog_maindb_92_990.sql
\set ECHO all
ROLLBACK TO SAVEPOINT maindb_guard;
SAVEPOINT otherdb_guard;
\set ECHO none
\i @abs_srcdir@/../../include/catalog/upgrade_sql/upgrade_catalog_otherdb/upgrade_catalog_otherdb_92_990.sql
\set ECHO all
ROLLBACK TO SAVEPOINT otherdb_guard;
ROLLBACK;
