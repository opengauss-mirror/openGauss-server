DROP LARGE SEQUENCE pg_seq_params_seq1;

CREATE DATABASE test_db_b DBCOMPATIBILITY 'B';
\c test_db_b

-- test reset sequence
CREATE TABLE truncate_a (id int auto_increment primary key, name VARCHAR(64));
insert into truncate_a(name) values ('a001'), ('a002'),('a003'),('a004');
truncate TABLE truncate_a ;
select get_auto_increment_nextval('truncate_a'::regclass::oid, false);
select get_auto_increment_nextval('truncate_a'::regclass::oid, true);
alter large sequence truncate_a_id_seq global;
truncate TABLE truncate_a ;
select get_auto_increment_nextval('truncate_a'::regclass::oid, false);
select get_auto_increment_nextval('truncate_a'::regclass::oid, true);

-- 模拟64-bit sequence
update pg_class set relkind='z'  where relname='truncate_a_id_seq';
select get_auto_increment_nextval('truncate_a'::regclass::oid, false);
select get_auto_increment_nextval('truncate_a'::regclass::oid, true);
update pg_class set relkind='Z'  where relname='truncate_a_id_seq';
drop table truncate_a cascade;

\c regression
drop database test_db_b;

-- add Coverage 1 
create tablespace ts1 location '/tmp/ts1';
create tablespace ts2 location '/tmp/ts2';
create database test_db_ts tablespace ts1;
\c test_db_ts
create table tbl1(id bigserial PRIMARY KEY, data text) tablespace ts2;
drop table tbl1 ;

\c regression
drop database test_db_ts;
drop tablespace ts1;
drop tablespace ts2;
