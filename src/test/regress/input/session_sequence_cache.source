select nextval('seq_test_table');
select nextval('seq_test_table');
select nextval('seq_test_table');
select setval('seq_test_table', 1);
select seq_test_table.currval;
insert into test_table_for_seq values 
    (currval('seq_test_table'), 'values1'),
    (nextval('seq_test_table'), 'values2'),
    (nextval('seq_test_table'), 'values3'),
    (nextval('seq_test_table'), 'values4'),
