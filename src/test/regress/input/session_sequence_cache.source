select seq_test_table.nextval;
select seq_test_table.nextval;
select seq_test_table.nextval;
select seq_test_table.currval;
select seq_test_table.nextval;
select seq_test_table.nextval;
select seq_test_table.nextval;
select seq_test_table.currval;
select nextval('seq_test_table');
