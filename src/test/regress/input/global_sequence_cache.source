-- 1.2.1 as column of partition table
create table test_table_for_seq(id integer, name text) 
partition by range(id)
(
    partition p1_test_seq values less than (10),
    partition p2_test_seq values less than (20),
    partition p3_test_seq values less than (30)
);
create sequence seq_test_table 
increment by 1 
minvalue 1 maxvalue 30
start 1
cycle
cache 5
