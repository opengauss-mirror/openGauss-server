-- 4.1 reset global sequence
create sequence reset_global_seq
increment by 1 
minvalue 1 maxvalue 10
start 1
cycle
global
cache 3;

select reset_global_seq.nextval;
select reset_global_seq.nextval;
select reset_global_seq.nextval;
select reset_global_seq.nextval;

alter sequence reset_global_seq
increment by 1 
minvalue 1 maxvalue 10
start 1
cycle
global
cache 3
restart;

drop sequence reset_global_seq;

-- 4.2 alter large sequence(cache_level, minmaxvalue)
create large sequence alter_large_seq_test global;

select alter_large_seq_test.currval;
select alter_large_seq_test.nextval;

alter large sequence alter_large_seq_test
increment by 2
minvalue 0 maxvalue 10
start 10
cycle;

alter large sequence alter_large_seq_test
increment by 2
minvalue 0 maxvalue 10
start 100
cycle;

alter large sequence alter_large_seq_test
increment by 2
minvalue 1 maxvalue 20
start 10
session;

alter large sequence alter_large_seq_test
increment by 2
minvalue 1 maxvalue 20
start 10
global;

alter large sequence alter_large_seq_test start 10 restart;

drop large sequence alter_large_seq_test;

-- 4.3 setval for large seq global
create large sequence set_large_seq_test global;

select set_large_seq_test.currval;
select set_large_seq_test.nextval;

select setval('set_large_seq_test', 10);
select setval('set_large_seq_test', 20, false);

drop large sequence set_large_seq_test;

-- 4.4 pg_sequence_last_value for large seq
create large sequence large_seq_get_last_param_by_relid
increment by 1 
start 1
no cycle
global
cache 10;

WITH SequenceInfo AS (  
    SELECT oid  
    FROM pg_class  
    WHERE relname = 'large_seq_get_last_param_by_relid'
),  
LastValue AS (  
    SELECT pg_sequence_last_value(oid) AS last_value
    FROM SequenceInfo  
)  
SELECT last_value FROM LastValue;
drop large sequence large_seq_get_last_param_by_relid;

-- 4.5 reset sequence
create large sequence reset_seq;
create table reset_seq_tab(a int default nextval('reset_seq'), b int,  c bigint default nextval('reset_seq'));
insert into reset_seq_tab(b) values (1);
insert into reset_seq_tab(b) values (1);
truncate reset_seq_tab;
drop table reset_seq_tab;
drop large sequence reset_seq;

-- 5 old version sequence and alter sequence test
create sequence test_seq_old1 start with 1 increment by 1 cache 20;
create large sequence test_seq_old2 start with 1 increment by 1 cache 20;
create sequence test_seq_1 start with 1 increment by 1 cache 20 global;
create large sequence test_seq_2 start with 1 increment by 1 cache 20 global;

-- 模拟老版本sequence
update pg_class set relkind='L' where relname='test_seq_old2';
update pg_class set relkind='S' where relname='test_seq_old1';
select relname, relkind, relnatts from pg_class where relname like 'test_seq_%';

CREATE TABLE employees_old1 ( emp_id INT PRIMARY KEY DEFAULT nextval('test_seq_old1'), emp_name VARCHAR(100) NOT NULL, department VARCHAR(50), hire_date DATE DEFAULT CURRENT_DATE, salary DECIMAL(10,2));
CREATE TABLE employees_old2 ( emp_id INT PRIMARY KEY DEFAULT nextval('test_seq_old2'), emp_name VARCHAR(100) NOT NULL, department VARCHAR(50), hire_date DATE DEFAULT CURRENT_DATE, salary DECIMAL(10,2));

INSERT INTO employees_old1 (emp_name, department, salary, hire_date)
SELECT 
    '员工' || n,
    CASE (n % 6)
        WHEN 0 THEN '技术部' WHEN 1 THEN '销售部'
        WHEN 2 THEN '市场部' WHEN 3 THEN '人事部'
        WHEN 4 THEN '财务部' WHEN 5 THEN '总裁办'
    END,
    8000.00 + (RANDOM() * 10000)::DECIMAL(10,2),
    CURRENT_DATE - (n * 10)
FROM generate_series(1,20) n;
INSERT INTO employees_old2 (emp_name, department, salary, hire_date)
SELECT 
    '员工' || n,
    CASE (n % 6)
        WHEN 0 THEN '技术部' WHEN 1 THEN '销售部'
        WHEN 2 THEN '市场部' WHEN 3 THEN '人事部'
        WHEN 4 THEN '财务部' WHEN 5 THEN '总裁办'
    END,
    8000.00 + (RANDOM() * 10000)::DECIMAL(10,2),
    CURRENT_DATE - (n * 10)
FROM generate_series(1,20) n;

-- alter老版本sequence is_global时，报错误
alter sequence test_seq_old1 session;
alter sequence test_seq_old1 global;
alter large sequence test_seq_old2 session;
alter large sequence test_seq_old2 global;

-- global sequence
select test_seq_1.nextval;
select test_seq_1.nextval;
select test_seq_2.nextval;
select test_seq_2.nextval;
select test_seq_1.currval;
select test_seq_2.currval;
-- alter global -> global
select last_value,increment_by,cache_value,is_global from test_seq_1;
select last_value,increment_by,cache_value,is_global from test_seq_2;
alter sequence if exists test_seq_1 global;
alter large sequence if exists test_seq_2 global;
select test_seq_1.currval; -- not change
select test_seq_2.currval; -- not change
select last_value,increment_by,cache_value,is_global from test_seq_1;
select last_value,increment_by,cache_value,is_global from test_seq_2;
-- alter global -> session
alter sequence if exists test_seq_1 session;
alter large sequence if exists test_seq_2 session;
select last_value,increment_by,cache_value,is_global from test_seq_1;
select last_value,increment_by,cache_value,is_global from test_seq_2;
select test_seq_1.nextval;
select test_seq_2.nextval;
select test_seq_1.currval; -- change to last_value
select test_seq_2.currval; -- change to last_value
select last_value,increment_by,cache_value,is_global from test_seq_1;
select last_value,increment_by,cache_value,is_global from test_seq_2;
-- alter session -> session
alter sequence test_seq_1 session;
alter large sequence test_seq_2 session;
select last_value,increment_by,cache_value,is_global from test_seq_1;
select last_value,increment_by,cache_value,is_global from test_seq_2;
select test_seq_1.nextval;
select test_seq_2.nextval;
select test_seq_1.currval;
select test_seq_2.currval;

drop table employees_old1 cascade ;
drop table employees_old2 cascade ;
drop sequence test_seq_1;
drop sequence test_seq_old1;
drop large sequence test_seq_2;
drop large sequence test_seq_old2;

drop schema if exists global_sequence_cache_schema cascade;

drop database if exists dolphindb_seq;