create sequence seq_test_setval
increment by 1 
start 1
no cycle
global
cache 10;

create sequence seq_test_setval1
increment by 1 
start 1
no cycle
global
cache 10;

create sequence seq_test_setval2
increment by 1 
start 1
no cycle
global
cache 10;

select setval('seq_test_setval', 4);
select seq_test_setval.currval;
select lastval();
select seq_test_setval.nextval;
select setval('seq_test_setval', 14);
select seq_test_setval.currval;
select lastval();

select setval('seq_test_setval1', 5, true);
select seq_test_setval1.currval;
select lastval();
select seq_test_setval1.nextval;
select setval('seq_test_setval1', 15, true);
select seq_test_setval1.currval;
select lastval();

