create database test_pg_identity_dump_restore dbcompatibility 'A';
create database test_pg_identity_dump_restore_1 dbcompatibility 'A';
\c test_pg_identity_dump_restore
create schema test_pg_identity_dump_restore;
set current_schema = test_pg_identity_dump_restore;

CREATE TABLE test_t1 (a int GENERATED ALWAYS AS IDENTITY (START WITH 20 INCREMENT 2 NOMAXVALUE NOMINVALUE), b text);
CREATE TABLE test_t2 (a int GENERATED BY DEFAULT AS IDENTITY ( START 10 INCREMENT 1 MAXVALUE 2222), b text);
ALTER TABLE test_t2 ADD COLUMN c int GENERATED ALWAYS AS IDENTITY (START 20 NOMAXVALUE NOMINVALUE NOCYCLE); -- success
ALTER TABLE test_t2 ALTER COLUMN c SET GENERATED BY DEFAULT SET INCREMENT BY 2 SET START WITH 100 RESTART;

INSERT INTO test_t1 DEFAULT VALUES;
INSERT INTO test_t1 DEFAULT VALUES;
INSERT INTO test_t2 DEFAULT VALUES;
INSERT INTO test_t2 DEFAULT VALUES;


\! @abs_bindir@/gs_dump test_pg_identity_dump_restore -p @portstring@ -f @abs_bindir@/test_pg_identity_dump_restore.sql -n test_pg_identity_dump_restore -w >/dev/null 2>&1; echo $?
\! @abs_bindir@/gsql -dtest_pg_identity_dump_restore_1 -p @portstring@ -f "@abs_bindir@/test_pg_identity_dump_restore.sql";

\c test_pg_identity_dump_restore_1
set current_schema = test_pg_identity_dump_restore;

\d+ test_t1
\d+ test_t2
truncate test_t1;
truncate test_t2;
\d+ test_t2_c_seq

INSERT INTO test_t1 DEFAULT VALUES;
INSERT INTO test_t1 DEFAULT VALUES;
INSERT INTO test_t2 DEFAULT VALUES;
INSERT INTO test_t2 DEFAULT VALUES;
select * from test_t1 order by 1, 2;
select * from test_t2 order by 1, 2;

\c regression
DROP DATABASE test_pg_identity_dump_restore;
DROP DATABASE test_pg_identity_dump_restore_1;
