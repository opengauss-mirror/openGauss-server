    (38, 'TZ', 'other'),
    (39, 'US', 'time_number'),
    (40, 'X', 'other'),
    (41, 'Y,YYY', 'other'),
    (42, 'a.d.', 'other'),
    (43, 'a.m.', 'meridiem'),
    (44, 'ad', 'other'),
    (45, 'am', 'meridiem'),
    (46, 'b.c.', 'other'),
    (47, 'bc', 'other'),
    (48, 'day', 'name'),
    (49, 'dy', 'name'),
    (50, 'ff1', 'time_number'),
    (51, 'ff2', 'time_number'),
    (52, 'ff3', 'time_number'),
    (53, 'ff4', 'time_number'),
    (54, 'ff5', 'time_number'),
    (55, 'ff6', 'time_number'),
    (56, 'ff', 'time_number'),
    (57, 'fx', 'other'),
    (58, 'hh24', 'time_number'),
    (59, 'hh12', 'time_number'),
    (60, 'hh', 'time_number'),
    (61, 'mi', 'time_number'),
    (62, 'month', 'name'),
    (63, 'mon', 'name'),
    (64, 'ms', 'time_number'),
    (65, 'p.m.', 'meridiem'),
    (66, 'pm', 'meridiem'),
    (67, 'rm', 'other'),
    (68, 'rrrr', 'other'),
    (69, 'rr', 'other'),
    (70, 'sssss', 'time_number'),
    (71, 'ss', 'time_number'),
    (72, 'syyyy', 'other'),
    (73, 'tzh', 'other'),
    (74, 'tzm', 'other'),
    (75, 'tz', 'other'),
    (76, 'us', 'time_number'),
    (77, 'x', 'other'),
    (78, 'y,yyy', 'other');
-- 2. Basic fields: call the existing type overloads directly for each field and input value.
-- 2.1 Names and other non-integer fields for timestamp and timestamptz.
select v.id, f.id as format_id, f.picture,
       '[' || to_char(v.ts, f.picture) || ']' as timestamp_result,
       '[' || to_char(v.tz, f.picture) || ']' as timestamptz_result
from datetime_inputs v cross join datetime_formats f
where f.category <> 'time_number'
order by v.id, f.id;
