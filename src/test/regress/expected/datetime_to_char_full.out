    (22, 'MI', 'time_number'),
    (23, 'MONTH', 'name'),
    (24, 'MON', 'name'),
    (25, 'MS', 'time_number'),
    (26, 'Month', 'name'),
    (27, 'Mon', 'name'),
    (28, 'P.M.', 'meridiem'),
    (29, 'PM', 'meridiem'),
    (30, 'RM', 'other'),
    (31, 'RRRR', 'other'),
