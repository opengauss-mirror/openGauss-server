    (7, 'DAY', 'name'),
    (8, 'DY', 'name'),
    (9, 'Day', 'name'),
    (10, 'Dy', 'name'),
    (11, 'FF1', 'time_number'),
    (12, 'FF2', 'time_number'),
    (13, 'FF3', 'time_number'),
    (14, 'FF4', 'time_number'),
    (15, 'FF5', 'time_number'),
    (16, 'FF6', 'time_number'),
    (17, 'FF', 'time_number'),
    (18, 'FX', 'other'),
    (19, 'HH24', 'time_number'),
