NOTICE:  schema "indexonly_astore_smp" does not exist, skipping
CREATE SCHEMA indexonly_astore_smp;
SET CURRENT_SCHEMA TO indexonly_astore_smp;
DROP TABLE IF EXISTS t1;
NOTICE:  table "t1" does not exist, skipping
CREATE TABLE t1 (a INT, b INT, c INT) WITH (STORAGE_TYPE = ASTORE);
CREATE INDEX i_t1 on t1(b);
