CREATE OR REPLACE FUNCTION select_one_table(out1 OUT bigint)
AS 'SELECT COUNT(*) FROM (SELECT /*+indexonlyscan(t1 i_t1)*/ b FROM t1 ORDER BY b DESC)'
LANGUAGE SQL;
SELECT select_one_table();
