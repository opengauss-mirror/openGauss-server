(4 rows)

SET QUERY_DOP = 2002;
DROP TABLE IF EXISTS partition_scan_stu_info1;
DROP TABLE IF EXISTS partition_scan_stu_info2;
RESET CURRENT_SCHEMA;
DROP SCHEMA IF EXISTS index_smp_othercase CASCADE;
set enable_expr_fusion=off;
