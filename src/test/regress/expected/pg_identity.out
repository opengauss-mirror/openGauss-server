 a | b 
---+---
 1 | 
 2 | 
(2 rows)

SELECT * FROM itest2 order by a;
 a | b 
---+---
 1 | 
 2 | 
(2 rows)

SELECT * FROM itest3 order by a;
 a  | b 
----+---
  7 | 
 12 | 
(2 rows)

INSERT INTO itest1 VALUES (10, 'xyz');
INSERT INTO itest1 OVERRIDING USER VALUE VALUES (10, 'xyz');
SELECT * FROM itest1 order by a;
 a  |  b  
----+-----
  1 | 
  2 | 
  3 | xyz
 10 | xyz
(4 rows)

INSERT INTO itest2 VALUES (10, 'xyz'); -- error
ERROR:  cannot insert a non-DEFAULT value into column "a"
DETAIL:  Column "a" is an identity column defined as "GENERATED ALWAYS".
HINT:  Use OVERRIDING SYSTEM VALUE to override.
INSERT INTO itest2 OVERRIDING SYSTEM VALUE VALUES (10, 'xyz');
SELECT * FROM itest2;
 a  |  b  
----+-----
  1 | 
  2 | 
 10 | xyz
(3 rows)

CREATE TABLE test_t1 (a int GENERATED ALWAYS AS IDENTITY, b text);
NOTICE:  CREATE TABLE will create implicit sequence "test_t1_a_seq" for serial column "test_t1.a"
INSERT INTO test_t1 VALUES('xxxx'); -- error
ERROR:  invalid input syntax for integer: "xxxx"
LINE 1: INSERT INTO test_t1 VALUES('xxxx');
                                   ^
CONTEXT:  referenced column: a
INSERT INTO test_t1(b) VALUES('xxxx'); -- success
INSERT INTO test_t1(a, b) VALUES(1, 'xxxx'); -- error
ERROR:  cannot insert a non-DEFAULT value into column "a"
DETAIL:  Column "a" is an identity column defined as "GENERATED ALWAYS".
HINT:  Use OVERRIDING SYSTEM VALUE to override.
INSERT INTO test_t1 VALUES(1, 'xxxx'); -- error
ERROR:  cannot insert a non-DEFAULT value into column "a"
DETAIL:  Column "a" is an identity column defined as "GENERATED ALWAYS".
HINT:  Use OVERRIDING SYSTEM VALUE to override.
INSERT INTO test_t1 VALUES(DEFAULT, 'xxxx'); -- success
INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(1111, 'xx'); -- success
INSERT INTO test_t1 OVERRIDING USER VALUE VALUES(1111, 'xxxx');  -- success
INSERT INTO test_t1(a, b) OVERRIDING USER VALUE VALUES(DEFAULT, 'xxxx'); -- success
INSERT INTO test_t1(a, b) OVERRIDING SYSTEM VALUE VALUES(1, 'xxxx'); -- success
INSERT INTO test_t1(a, b) select 1, 'xxxxx'; -- error
ERROR:  cannot insert a non-DEFAULT value into column "a"
DETAIL:  Column "a" is an identity column defined as "GENERATED ALWAYS".
HINT:  Use OVERRIDING SYSTEM VALUE to override.
INSERT INTO test_t1(a, b) OVERRIDING USER VALUE select 1, 'xxxxx'; -- success
INSERT INTO test_t1(a, b) OVERRIDING SYSTEM VALUE select 12222, 'xxxxx'; -- success
SELECT * FROM test_t1 ORDER BY a;
   a   |   b   
-------+-------
     1 | xxxx
     1 | xxxx
     2 | xxxx
     3 | xxxx
     4 | xxxx
     5 | xxxxx
  1111 | xx
 12222 | xxxxx
(8 rows)

