DROP TABLE test_t1, test_t2;
--## inline view tests
CREATE TABLE test_t1 (a int GENERATED ALWAYS AS IDENTITY, b text, c int);
NOTICE:  CREATE TABLE will create implicit sequence "test_t1_a_seq" for serial column "test_t1.a"
CREATE TABLE test_t2 (a int GENERATED ALWAYS AS IDENTITY, b text, c int);
NOTICE:  CREATE TABLE will create implicit sequence "test_t2_a_seq" for serial column "test_t2.a"
INSERT INTO test_t1 DEFAULT VALUES;
INSERT INTO test_t2 DEFAULT VALUES;
-- insert
INSERT INTO (SELECT a, b FROM test_t1 WHERE a = 1) sup
    SELECT 2, 'inline view'; -- error
ERROR:  cannot insert a non-DEFAULT value into column "a"
DETAIL:  Column "a" is an identity column defined as "GENERATED ALWAYS".
HINT:  Use OVERRIDING SYSTEM VALUE to override.
INSERT INTO (SELECT a, b FROM test_t1 WHERE a = 1) sup
    OVERRIDING SYSTEM VALUE SELECT 22, 'inline view'; -- success
INSERT INTO (SELECT a, b FROM test_t1 WHERE a = 1) sup
    OVERRIDING USER VALUE SELECT 12, 'inline view'; -- success
SELECT * FROM test_t1 order by 1, 2;
 a  |      b      | c 
----+-------------+---
  1 |             |  
  2 | inline view |  
 22 | inline view |  
(3 rows)

-- update
UPDATE (SELECT a, b FROM test_t1 WHERE a = 1) sup -- SET TO DEFAULT is not supported for subquery "sup"
    SET sup.a = 2; -- error
ERROR:  column "a" can only be updated to DEFAULT
DETAIL:  Column "a" is an identity column defined as "GENERATED ALWAYS".
UPDATE (SELECT a, b FROM test_t1 WHERE a = 1) sup
    SET sup.a = DEFAULT; -- error
ERROR:  SET TO DEFAULT is not supported for subquery "sup"
UPDATE (SELECT a, b FROM test_t1 WHERE a = 12) sup
    SET sup.a = DEFAULT, b = 'inline view updated'; -- error
ERROR:  SET TO DEFAULT is not supported for subquery "sup"
SELECT * FROM test_t1 order by 1, 2;
 a  |      b      | c 
----+-------------+---
  1 |             |  
  2 | inline view |  
 22 | inline view |  
(3 rows)

UPDATE (SELECT a, b FROM test_t1 WHERE a = 1) sup
    SET sup.a = DEFAULT; -- error
ERROR:  SET TO DEFAULT is not supported for subquery "sup"
UPDATE (SELECT a, b FROM test_t1 WHERE a = 1) sup
    SET sup.b = 'inline view updated'; -- success
SELECT * FROM test_t1 order by 1, 2;
 a  |          b          | c 
----+---------------------+---
  1 | inline view updated |  
  2 | inline view         |  
 22 | inline view         |  
(3 rows)

DROP TABLE test_t1, test_t2;
