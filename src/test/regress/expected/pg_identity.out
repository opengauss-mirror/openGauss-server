-- identity sequence options
CREATE TABLE test_t5 (a int2 GENERATED ALWAYS AS IDENTITY (START WITH 10 MAXVALUE 30 MINVALUE 12), b text); -- error
NOTICE:  CREATE TABLE will create implicit sequence "test_t5_a_seq" for serial column "test_t5.a"
ERROR:  START value (10) cannot be less than MINVALUE (12)
CREATE TABLE test_t5 (a int2 GENERATED ALWAYS AS IDENTITY (START WITH 10 MAXVALUE 30 MINVALUE 9), b text); -- success
NOTICE:  CREATE TABLE will create implicit sequence "test_t5_a_seq" for serial column "test_t5.a"
\d+ test_t5;
                                      Table "public.test_t5"
 Column |   Type   |               Modifiers               | Storage  | Stats target | Description 
--------+----------+---------------------------------------+----------+--------------+-------------
