--## upserts tests
CREATE TABLE test_t1 (a int PRIMARY KEY GENERATED ALWAYS AS IDENTITY , b text);
NOTICE:  CREATE TABLE will create implicit sequence "test_t1_a_seq" for serial column "test_t1.a"
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_t1_pkey" for table "test_t1"
INSERT INTO test_t1 VALUES (DEFAULT, default);
SELECT * FROM test_t1;
 a | b 
---+---
 1 | 
(1 row)

INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(1, 'xxxx'); -- error
ERROR:  duplicate key value violates unique constraint "test_t1_pkey"
DETAIL:  Key (a)=(1) already exists.
INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(1, 'setb') ON DUPLICATE KEY UPDATE b = 'setb'; -- success
INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(1, 'nothing') ON DUPLICATE KEY UPDATE NOTHING; -- success
SELECT * FROM test_t1 order by 1, 2; -- 1, setb
 a |  b   
---+------
 1 | setb
(1 row)

INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(1, 'nothing') ON DUPLICATE KEY UPDATE a = 2; -- error
ERROR:  INSERT ON DUPLICATE KEY UPDATE don't allow update on primary key or unique key.
INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(1, 'seta') ON DUPLICATE KEY UPDATE b = 'seta';  -- success
SELECT * FROM test_t1 order by 1, 2; -- 1, seta
 a |  b   
---+------
 1 | seta
(1 row)

INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(1, 'seta') ON DUPLICATE KEY UPDATE b = 'setc', a = DEFAULT; -- error
ERROR:  INSERT ON DUPLICATE KEY UPDATE don't allow update on primary key or unique key.
SELECT * FROM test_t1 order by 1, 2; -- 1, seta
 a |  b   
---+------
 1 | seta
(1 row)

INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(2, 'test1'); -- success
INSERT INTO test_t1 OVERRIDING USER VALUE VALUES(1111, 'test1'); -- error
ERROR:  duplicate key value violates unique constraint "test_t1_pkey"
DETAIL:  Key (a)=(2) already exists.
INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(3, 'test1'); -- success
INSERT INTO test_t1 OVERRIDING USER VALUE VALUES(1111, 'test1') ON DUPLICATE KEY UPDATE b = 'w3' WHERE a = 3; -- success
INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(4, 'test1'); -- success
INSERT INTO test_t1 OVERRIDING USER VALUE VALUES(1111, 'test1') ON DUPLICATE KEY UPDATE a = 5 WHERE a = 4; -- error, 未自增
ERROR:  INSERT ON DUPLICATE KEY UPDATE don't allow update on primary key or unique key.
SELECT * FROM test_t1 order by 1, 2;
 a |   b   
---+-------
 1 | seta
 2 | test1
 3 | w3
 4 | test1
(4 rows)

INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(5, 'test1'); -- success
INSERT INTO test_t1 OVERRIDING USER VALUE VALUES(1111, 'test1') ON DUPLICATE KEY UPDATE b = 'w5', a = DEFAULT WHERE a = 5; -- error, 未自增
ERROR:  INSERT ON DUPLICATE KEY UPDATE don't allow update on primary key or unique key.
INSERT INTO test_t1 OVERRIDING SYSTEM VALUE VALUES(6, 'test1'); -- success
INSERT INTO test_t1 OVERRIDING USER VALUE VALUES(1111, 'test1') ON DUPLICATE KEY UPDATE b = 'w6' WHERE a = 4; -- success
SELECT * FROM test_t1 order by 1, 2;
 a |   b   
---+-------
 1 | seta
 2 | test1
 3 | w3
 4 | w6
 5 | test1
 6 | test1
(6 rows)

