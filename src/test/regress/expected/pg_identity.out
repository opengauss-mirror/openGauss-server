--## merge tests
-- when not matched insert
create table target_table (
    id int GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name varchar(50),
    age int
);
NOTICE:  CREATE TABLE will create implicit sequence "target_table_id_seq" for serial column "target_table.id"
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "target_table_pkey" for table "target_table"
create table source_table (id int, name varchar(50), age int);
insert into source_table values (10, 'zliu', 28), (11, 'sqi', 30);
-- expected: success. let id generated by system.
merge into target_table AS t using source_table AS s ON t.id = s.id
when not matched then
    insert (name, age) values (s.name, s.age);
-- expected: error
merge into target_table AS t using source_table AS s ON t.id = s.id
when not matched then
    insert (id, name, age) values (1, 'error', 21);
ERROR:  cannot insert a non-DEFAULT value into column "id"
DETAIL:  Column "id" is an identity column defined as "GENERATED ALWAYS".
HINT:  Use OVERRIDING SYSTEM VALUE to override
-- expected: success
merge into target_table AS t using source_table AS s ON t.id = s.id
when not matched then
    insert (id, name, age) OVERRIDING USER VALUE values (1, 'success', 22); -- 3
-- expected: error
merge into target_table AS t using source_table AS s ON t.id = s.id
when not matched then
    insert (id, name, age) OVERRIDING SYSTEM VALUE values (2, 'error', 23);
ERROR:  duplicate key value violates unique constraint "target_table_pkey"
DETAIL:  Key (id)=(2) already exists.
-- expected: error
merge into target_table AS t using source_table AS s ON t.id = s.id
when not matched then
    insert (id, name, age) OVERRIDING SYSTEM VALUE values (3, 'error', 24);
ERROR:  duplicate key value violates unique constraint "target_table_pkey"
DETAIL:  Key (id)=(3) already exists.
-- expected: success
merge into target_table AS t using source_table AS s ON t.id = s.id
when not matched then
    insert (id, name, age) OVERRIDING USER VALUE values (3, 'success', 25);
-- expected: success
merge into target_table AS t using source_table AS s ON t.id = s.id
when not matched then
    insert (id, name, age) OVERRIDING SYSTEM VALUE values (DEFAULT, 'success', 26);
-- expected: success
merge into target_table AS t using source_table AS s ON t.id = s.id
when not matched then
    insert (id, name, age) OVERRIDING USER VALUE values (DEFAULT, 'success', 27);
SELECT * from target_table order by id;
 id |  name   | age 
----+---------+-----
  1 | zliu    |  28
  2 | sqi     |  30
  3 | success |  22
  4 | success |  22
  5 | success |  25
  6 | success |  25
  7 | success |  26
  8 | success |  26
  9 | success |  27
 10 | success |  27
(10 rows)

DROP TABLE target_table, source_table;
-- when matched update
create table target_table (
    id int  GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name varchar(50), 
    age int
);
NOTICE:  CREATE TABLE will create implicit sequence "target_table_id_seq" for serial column "target_table.id"
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "target_table_pkey" for table "target_table"
create table source_table (id int, name varchar(50), age int);
insert into source_table values (1, 'zliu', 28), (2, 'sqi', 30);
-- success
insert into target_table default values;
merge into target_table AS t using source_table AS s ON t.id = s.id
WHEN MATCHED THEN
  UPDATE SET name = s.name, age = s.age + 1;
-- error
insert into target_table default values;
merge into target_table AS t using source_table AS s ON t.id = s.id
WHEN MATCHED THEN
  UPDATE SET id = s.id + 1;
ERROR:  Columns referenced in the ON Clause cannot be updated: "target_table"."id"
-- error
merge into target_table AS t using source_table AS s ON t.id = s.id
WHEN MATCHED THEN
  UPDATE SET id = DEFAULT, name = s.name, age = s.age + 1;
ERROR:  Columns referenced in the ON Clause cannot be updated: "target_table"."id"
SELECT * from target_table;
 id | name | age 
----+------+-----
  1 | zliu |  29
  2 |      |    
(2 rows)

DROP TABLE target_table, source_table;
-- CTE with modifying clause
CREATE TABLE test_t1 (a int GENERATED ALWAYS AS IDENTITY(START WITH 10) PRIMARY KEY, b text);
NOTICE:  CREATE TABLE will create implicit sequence "test_t1_a_seq" for serial column "test_t1.a"
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_t1_pkey" for table "test_t1"
CREATE TABLE test_t2 (a int GENERATED BY DEFAULT AS IDENTITY(START WITH 12) PRIMARY KEY, b text);
NOTICE:  CREATE TABLE will create implicit sequence "test_t2_a_seq" for serial column "test_t2.a"
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "test_t2_pkey" for table "test_t2"
-- error
WITH xxx AS (
    INSERT INTO test_t1(a, b) VALUES(1, 'xxxx') RETURNING a
) select * from xxx;
ERROR:  cannot insert a non-DEFAULT value into column "a"
DETAIL:  Column "a" is an identity column defined as "GENERATED ALWAYS".
HINT:  Use OVERRIDING SYSTEM VALUE to override.
-- success
WITH xxx AS (
    INSERT INTO test_t2(a, b) VALUES(1, 'x1') RETURNING a, b
) select * from xxx;
 a | b  
---+----
 1 | x1
(1 row)

-- success
WITH xxx AS (
    INSERT INTO test_t1(a, b) OVERRIDING SYSTEM VALUE VALUES(1, 'x1') RETURNING a, b
) select * from xxx;
 a | b  
---+----
 1 | x1
(1 row)

-- success
WITH xxx AS (
    INSERT INTO test_t1(a, b) OVERRIDING USER VALUE VALUES(3, 'x2') RETURNING a, b
) select * from xxx; -- should be 2
 a  | b  
----+----
 10 | x2
(1 row)

-- error
WITH xxx AS (
    UPDATE test_t1 SET a = 3 RETURNING a, b
) select * from xxx;
ERROR:  column "a" can only be updated to DEFAULT
DETAIL:  Column "a" is an identity column defined as "GENERATED ALWAYS".
-- error
WITH xxx AS (
    UPDATE test_t2 SET a = 3 RETURNING a, b
) select * from xxx;
 a | b  
---+----
 3 | x1
(1 row)

-- success
WITH xxx AS (
    UPDATE test_t1 SET a = DEFAULT, b = 't1_updated' RETURNING a, b
) select * from xxx;
 a  |     b      
----+------------
 11 | t1_updated
 12 | t1_updated
(2 rows)

-- success
WITH xxx AS (
    UPDATE test_t2 SET a = DEFAULT, b = 't2_updated' RETURNING a, b
) select * from xxx;
 a  |     b      
----+------------
 12 | t2_updated
(1 row)

DROP TABLE test_t1, test_t2;
