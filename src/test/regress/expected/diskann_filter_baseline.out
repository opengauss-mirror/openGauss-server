DEALLOCATE changing_vector;
RESET enable_opfusion;
RESET ann_orderby_distance_reuse;
RESET enable_seqscan;
RESET enable_indexscan;
RESET enable_bitmapscan;
RESET search_path;
DROP SCHEMA diskann_filter_baseline CASCADE;
