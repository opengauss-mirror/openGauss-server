-- A-format databases always enforce primary-key and non-primary-key unique indexes.
CREATE SCHEMA unique_check;
SET current_schema TO 'unique_check';
CREATE TABLE warehouse_a (
    w_id int PRIMARY KEY,
    w_code int UNIQUE
);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "warehouse_a_pkey" for table "warehouse_a"
NOTICE:  CREATE TABLE / UNIQUE will create implicit index "warehouse_a_w_code_key" for table "warehouse_a"
INSERT INTO warehouse_a VALUES (1, 10);
SET unique_checks = off;
INSERT INTO warehouse_a VALUES (1, 20);
ERROR:  duplicate key value violates unique constraint "warehouse_a_pkey"
DETAIL:  Key (w_id)=(1) already exists.
INSERT INTO warehouse_a VALUES (2, 10);
ERROR:  duplicate key value violates unique constraint "warehouse_a_w_code_key"
DETAIL:  Key (w_code)=(10) already exists.
RESET unique_checks;
DROP SCHEMA unique_check CASCADE;
NOTICE:  drop cascades to table warehouse_a
RESET current_schema;
-- B-format databases only allow unique_checks to control non-primary-key unique indexes.
CREATE DATABASE unique_check_b DBCOMPATIBILITY 'B';
\c unique_check_b
CREATE SCHEMA unique_check;
SET current_schema TO 'unique_check';
CREATE TABLE warehouse_b (
    w_id int PRIMARY KEY,
    w_code int UNIQUE
);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "warehouse_b_pkey" for table "warehouse_b"
NOTICE:  CREATE TABLE / UNIQUE will create implicit index "warehouse_b_w_code_key" for table "warehouse_b"
INSERT INTO warehouse_b VALUES (1, 10), (2, 20);
CREATE TABLE warehouse_b_col (
    w_id int PRIMARY KEY,
    w_code int UNIQUE
) WITH (orientation = column, deltarow_threshold = 0);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "warehouse_b_col_pkey" for table "warehouse_b_col"
NOTICE:  CREATE TABLE / UNIQUE will create implicit index "warehouse_b_col_w_code_key" for table "warehouse_b_col"
INSERT INTO warehouse_b_col VALUES (1, 10), (2, 20);
CREATE TABLE warehouse_b_idx (w_id int, w_code int);
CREATE UNIQUE INDEX warehouse_b_idx_code_idx ON warehouse_b_idx(w_code);
INSERT INTO warehouse_b_idx VALUES (1, 10);
CREATE TABLE warehouse_b_deferred (
    w_id int,
    w_code int UNIQUE DEFERRABLE INITIALLY DEFERRED
);
NOTICE:  CREATE TABLE / UNIQUE will create implicit index "warehouse_b_deferred_w_code_key" for table "warehouse_b_deferred"
INSERT INTO warehouse_b_deferred VALUES (1, 10);
-- With unique_checks enabled, both primary-key and non-primary-key unique indexes are enforced.
INSERT INTO warehouse_b VALUES (1, 30);
