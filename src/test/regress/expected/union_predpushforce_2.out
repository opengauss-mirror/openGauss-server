EXPLAIN (COSTS OFF)
SELECT /*+set(rewrite_rule predpushforce)*/
    m.merchant_id,
    m.merchant_name,
    c.channel_id,
    c.channel_name,
    COALESCE(vs.total_settle_amt, 0) AS total_settle_amt
FROM merchants m
JOIN channels c
    ON m.m_category = 'RETAIL' AND c.channel_type = 'PROMOTION'
LEFT JOIN (
    SELECT
        merchant_id,
        channel_id,
        SUM(settle_amount) AS total_settle_amt
    FROM (
        SELECT merchant_id, channel_id, settle_amount FROM settle_current
        UNION ALL
        SELECT merchant_id, channel_id, settle_amount FROM settle_history
    ) t
    GROUP BY merchant_id, channel_id
) vs ON m.merchant_id = vs.merchant_id
    AND c.channel_id  = vs.channel_id
ORDER BY m.merchant_id, c.channel_id;
                                                 QUERY PLAN                                                  
-------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: m.merchant_id, c.channel_id
   ->  Nested Loop Left Join
         ->  Nested Loop
               ->  Seq Scan on merchants m
                     Filter: ((m_category)::text = 'RETAIL'::text)
               ->  Materialize
                     ->  Seq Scan on channels c
                           Filter: ((channel_type)::text = 'PROMOTION'::text)
         ->  GroupAggregate
               Group By Key: settle_current.merchant_id, settle_current.channel_id
               ->  Append
                     ->  Index Only Scan using idx_set_cur_comp on settle_current
                           Index Cond: ((merchant_id = m.merchant_id) AND (channel_id = c.channel_id))
                     ->  Bitmap Heap Scan on settle_history
                           Recheck Cond: ((m.merchant_id = merchant_id) AND (c.channel_id = channel_id))
                           ->  Bitmap Index Scan on idx_set_his_comp
                                 Index Cond: ((m.merchant_id = merchant_id) AND (c.channel_id = channel_id))
(18 rows)

