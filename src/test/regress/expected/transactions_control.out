-- DTS13: commit in a cursor loop with a non-scroll cursor
SET client_min_messages = warning;
DROP TABLE IF EXISTS dts13_test, dts13_test_re;
DROP PROCEDURE IF EXISTS dts13_test_function();
CREATE TABLE dts13_test(b int, a int);
INSERT INTO dts13_test VALUES(generate_series(1, 200000), generate_series(1, 200000));
CREATE TABLE dts13_test_re(a int);
CREATE OR REPLACE PROCEDURE public.dts13_test_function()
SECURITY DEFINER
AS
result int;
vn_count int := 0;
vn_count2 int := 0;
DECLARE
BEGIN
    TRUNCATE TABLE dts13_test_re;
    FOR rec IN (SELECT sum(a) FROM dts13_test GROUP BY a)
    LOOP
        vn_count := vn_count + 1;
        INSERT INTO dts13_test_re VALUES(rec.sum);
        IF vn_count >= 1000 THEN
            COMMIT;
            vn_count := 0;
        END IF;
    END LOOP;
END;
/
SET work_mem = 64;
CALL public.dts13_test_function();
 dts13_test_function 
---------------------
 
(1 row)

SELECT count(DISTINCT a) FROM dts13_test_re;
 count  
--------
 200000
(1 row)

SET
SET
DROP PROCEDURE dts13_test_function();
DROP TABLE dts13_test, dts13_test_re;

-- DTS13: preserve the current position of a non-scroll holdable cursor
START TRANSACTION;
DECLARE dts13_hold_cursor NO SCROLL CURSOR WITH HOLD FOR
    SELECT generate_series(1, 3);
\t on
FETCH 1 FROM dts13_hold_cursor;
1

COMMIT;
FETCH ALL FROM dts13_hold_cursor;
2
3

\t off
CLOSE dts13_hold_cursor;
DROP TABLE test2;
DROP TABLE test3;
--
create table test1(id int, name varchar(20));
insert into test1 values(1,'bbb');
CREATE OR REPLACE PROCEDURE PROC_OUT_PARAM_001(P1 OUT INT)
AS
BEGIN
select id into P1 from test1 where name = 'bbb';
insert into test1 values(P1,'ddd');
COMMIT;
insert into test1 values(P1,'eee');
ROLLBACK;
END;
/
DECLARE
V_P1 INT;
BEGIN
PROC_OUT_PARAM_001(V_P1);
END;
/
select * from test1;
 id | name 
----+------
  1 | bbb
  1 | ddd
(2 rows)

start transaction;
select * from test1 for share;
