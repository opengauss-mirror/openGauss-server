(3 rows)

EXPLAIN (COSTS OFF) EXECUTE partial_param(0);
             QUERY PLAN             
------------------------------------
 Sort
   Sort Key: k
   ->  HashAggregate
         Group By Key: k
         ->  Seq Scan on t_status
               Filter: (status = 0)
(6 rows)

EXECUTE partial_param(0);
