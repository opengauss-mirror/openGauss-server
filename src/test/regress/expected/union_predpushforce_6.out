CREATE SCHEMA IF NOT EXISTS union_predpushforce_6;
SET search_path=union_predpushforce_6;
DROP TABLE IF EXISTS pp_a,pp_b,pp_f,pp_gap,pp_y,pp_noidx,pp_incl,pp_reorder;
NOTICE:  table "pp_a" does not exist, skipping
NOTICE:  table "pp_b" does not exist, skipping
NOTICE:  table "pp_f" does not exist, skipping
NOTICE:  table "pp_gap" does not exist, skipping
NOTICE:  table "pp_y" does not exist, skipping
NOTICE:  table "pp_noidx" does not exist, skipping
NOTICE:  table "pp_incl" does not exist, skipping
NOTICE:  table "pp_reorder" does not exist, skipping
CREATE TABLE pp_a(id int, k int);
CREATE TABLE pp_b(id int, k int);
INSERT INTO pp_a VALUES(1,2),(2,3);
INSERT INTO pp_b VALUES(1,4),(2,5);
CREATE TABLE pp_f(col1 int,col2 int,col3 int,amount int);
INSERT INTO pp_f SELECT 1+g%100,1+(g/100)%10,1+(g/1000)%5,g%97 FROM generate_series(1,5000) g;
CREATE INDEX pp_f_idx ON pp_f(col1,col2);
CREATE TABLE pp_gap AS SELECT * FROM pp_f;
CREATE INDEX pp_gap_idx ON pp_gap(col1,col2,col3);
CREATE TABLE pp_y AS SELECT * FROM pp_f;
CREATE INDEX pp_y_idx ON pp_y(col2);
CREATE TABLE pp_noidx AS SELECT * FROM pp_f;
CREATE TABLE pp_incl (LIKE pp_f) WITH (storage_type=ustore);
INSERT INTO pp_incl SELECT * FROM pp_f;
CREATE INDEX pp_incl_idx ON pp_incl USING ubtree(col1) INCLUDE(col3);
CREATE TABLE pp_reorder(col2 int,col1 int,col3 int,amount int);
INSERT INTO pp_reorder SELECT col2,col1,col3,amount FROM pp_f;
CREATE INDEX pp_reorder_idx ON pp_reorder(col1,col2);
ANALYZE pp_reorder;
ANALYZE pp_a; ANALYZE pp_b; ANALYZE pp_f; ANALYZE pp_gap;
ANALYZE pp_y; ANALYZE pp_noidx; ANALYZE pp_incl;
SELECT 'col2_then_col1';
    ?column?    
----------------
 col2_then_col1
(1 row)

EXPLAIN (COSTS OFF) SELECT /*+ set(rewrite_rule predpushforce) */ a.id,b.id,v.total FROM pp_a a CROSS JOIN pp_b b LEFT JOIN (SELECT col1,col2,col3,SUM(amount) total FROM pp_f GROUP BY col1,col2,col3) v ON v.col2=a.k AND v.col1=b.k ORDER BY a.id,b.id,v.total;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.id, (sum(pp_f.amount))
   ->  Nested Loop Left Join
         ->  Nested Loop
               ->  Seq Scan on pp_a a
               ->  Materialize
                     ->  Seq Scan on pp_b b
         ->  HashAggregate
               Group By Key: pp_f.col1, pp_f.col2, pp_f.col3
               ->  Bitmap Heap Scan on pp_f
                     Recheck Cond: ((col1 = b.k) AND (col2 = a.k))
                     ->  Bitmap Index Scan on pp_f_idx
                           Index Cond: ((col1 = b.k) AND (col2 = a.k))
(13 rows)

