FROM union_view
WHERE row_id > 2
ORDER BY row_id, title;
 row_id |   title    
--------+------------
      3 | delta-3
      3 | snapshot-3
      4 | snapshot-4
      6 | snapshot-6
    101 | delta-101
    102 | delta-102
    103 | delta-103
    104 | delta-104
    105 | delta-105
    106 | delta-106
(10 rows)

-- Explicit ordered Top-K result guards scalar-key materialization.
SELECT row_id
FROM union_view
WHERE row_id > 2
ORDER BY embedding <-> '[0,0,0,0]', row_id
LIMIT 4;
 row_id 
--------
    101
    102
