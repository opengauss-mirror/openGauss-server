         Output: delta_t.row_id, delta_t.title, delta_t.embedding
         ->  Sort
               Output: delta_t.row_id, delta_t.title, delta_t.embedding
               Sort Key: delta_t.row_id, delta_t.title, delta_t.embedding
               ->  Append
                     ->  Index Scan using delta_t_pkey on union_all_required_columns_test.delta_t
                           Output: delta_t.row_id, delta_t.title, delta_t.embedding
                           Index Cond: (delta_t.row_id > 0)
                     ->  Index Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t
                           Output: snapshot_t.row_id, snapshot_t.title, snapshot_t.embedding
                           Index Cond: (snapshot_t.row_id > 0)
(14 rows)

