-- UNION ALL required-column pushdown: plan-shape and correctness coverage.
SET client_min_messages = warning;
DROP SCHEMA IF EXISTS union_all_required_columns_test CASCADE;
CREATE SCHEMA union_all_required_columns_test;
SET search_path = union_all_required_columns_test, public;
CREATE TABLE delta_t
(
    row_id bigint PRIMARY KEY,
    title text,
    embedding vector(4)
);
CREATE TABLE snapshot_t
(
    row_id bigint PRIMARY KEY,
    title text,
    embedding vector(4)
);
CREATE TABLE delete_t
(
    row_id bigint PRIMARY KEY,
    reason text,
    unused_delete text
);
-- row_id=3 occurs in both live branches to guard UNION ALL duplicates.
INSERT INTO delta_t VALUES
    (3,   'delta-3',   '[3.25,0,0,0]'),
    (101, 'delta-101', '[1.5,0,0,0]'),
    (102, 'delta-102', '[2.5,0,0,0]'),
    (103, 'delta-103', '[3.5,0,0,0]'),
    (104, 'delta-104', '[4.5,0,0,0]'),
    (105, 'delta-105', '[5.5,0,0,0]'),
    (106, 'delta-106', '[6.5,0,0,0]');
INSERT INTO snapshot_t VALUES
    (1, 'snapshot-1', '[1,0,0,0]'),
    (2, 'snapshot-2', '[2,0,0,0]'),
    (3, 'snapshot-3', '[3,0,0,0]'),
    (4, 'snapshot-4', '[4,0,0,0]'),
    (5, 'snapshot-5', '[5,0,0,0]'),
    (6, 'snapshot-6', '[6,0,0,0]');
INSERT INTO delete_t VALUES
    (2, 'deleted', 'must-not-escape'),
    (5, 'deleted', 'must-not-escape'),
    (99, 'other', 'must-not-escape');
CREATE INDEX delta_embedding_diskann ON delta_t
    USING diskann (embedding vector_l2_ops);
CREATE INDEX snapshot_embedding_diskann ON snapshot_t
    USING diskann (embedding vector_l2_ops);
CREATE VIEW union_view AS
SELECT row_id, title, embedding
FROM delta_t
UNION ALL
SELECT s.row_id, s.title, s.embedding
FROM snapshot_t s
WHERE NOT EXISTS
(
    SELECT 1
    FROM delete_t d
    WHERE d.row_id = s.row_id
);
-- Keep the representative path above key-only so its anti-join can use both
-- primary-key indexes.  Exercise a delete-side filter in a separate view.
CREATE VIEW union_view_delete_filter AS
SELECT row_id, title, embedding
FROM delta_t
UNION ALL
SELECT s.row_id, s.title, s.embedding
FROM snapshot_t s
WHERE NOT EXISTS
(
    SELECT 1
    FROM delete_t d
    WHERE d.row_id = s.row_id
      AND d.reason = 'deleted'
);
ANALYZE delta_t;
ANALYZE snapshot_t;
ANALYZE delete_t;
-- Keep plan guards deterministic on the intentionally tiny data set.
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = on;
SET enable_nestloop = off;
SET enable_union_all_diskann_topk_pushdown = on;
SET enable_union_all_required_columns_pushdown = on;
-- -------------------------------------------------------------------------
-- Plan guards: the four target SQL combinations.
-- -------------------------------------------------------------------------
-- WHERE only: all three sources expose row_id only.  The outer recheck and
-- unused title/embedding columns must not reappear.
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2;
                                               QUERY PLAN                                                
---------------------------------------------------------------------------------------------------------
 Result
   Output: delta_t.row_id
   ->  Append
         ->  Index Only Scan using delta_t_pkey on union_all_required_columns_test.delta_t
               Output: delta_t.row_id
               Index Cond: (delta_t.row_id > 2)
         ->  Merge Anti Join
               Output: s.row_id
               Merge Cond: (s.row_id = d.row_id)
               ->  Index Only Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t s
                     Output: s.row_id
                     Index Cond: (s.row_id > 2)
               ->  Index Only Scan using delete_t_pkey on union_all_required_columns_test.delete_t d
                     Output: d.row_id
(14 rows)

-- The same source pruning must work for a Hash Anti Join, not only Merge.
SET enable_mergejoin = off;
SET enable_hashjoin = on;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2;
                                                QUERY PLAN                                                 
-----------------------------------------------------------------------------------------------------------
 Result
   Output: delta_t.row_id
   ->  Append
         ->  Index Only Scan using delta_t_pkey on union_all_required_columns_test.delta_t
               Output: delta_t.row_id
               Index Cond: (delta_t.row_id > 2)
         ->  Hash Anti Join
               Output: s.row_id
               Hash Cond: (s.row_id = d.row_id)
               ->  Index Only Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t s
                     Output: s.row_id
                     Index Cond: (s.row_id > 2)
               ->  Hash
                     Output: d.row_id
                     ->  Index Only Scan using delete_t_pkey on union_all_required_columns_test.delete_t d
                           Output: d.row_id
(16 rows)

SET enable_hashjoin = off;
SET enable_mergejoin = on;
-- WHERE + ORDER BY: each branch emits row_id plus a scalar distance.  The
-- vector is consumed inside the branch and is not a UNION boundary column.
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2
ORDER BY embedding <-> '[0,0,0,0]';
                                                QUERY PLAN                                                 
-----------------------------------------------------------------------------------------------------------
 Sort
   Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
   Sort Key: ((delta_t.embedding <-> '[0,0,0,0]'::vector))
   ->  Result
         Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
         ->  Append
               ->  Index Scan using delta_t_pkey on union_all_required_columns_test.delta_t
                     Output: delta_t.row_id, (delta_t.embedding <-> '[0,0,0,0]'::vector)
                     Index Cond: (delta_t.row_id > 2)
               ->  Merge Anti Join
                     Output: s.row_id, (s.embedding <-> '[0,0,0,0]'::vector)
                     Merge Cond: (s.row_id = d.row_id)
                     ->  Index Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t s
                           Output: s.row_id, s.embedding
                           Index Cond: (s.row_id > 2)
                     ->  Index Only Scan using delete_t_pkey on union_all_required_columns_test.delete_t d
                           Output: d.row_id
(17 rows)

-- WHERE + LIMIT: retain one global Limit; never synthesize branch Limits.
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2
LIMIT 4;
                                                  QUERY PLAN                                                   
---------------------------------------------------------------------------------------------------------------
 Limit
   Output: delta_t.row_id
   ->  Result
         Output: delta_t.row_id
         ->  Append
               ->  Index Only Scan using delta_t_pkey on union_all_required_columns_test.delta_t
                     Output: delta_t.row_id
                     Index Cond: (delta_t.row_id > 2)
               ->  Merge Anti Join
                     Output: s.row_id
                     Merge Cond: (s.row_id = d.row_id)
                     ->  Index Only Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t s
                           Output: s.row_id
                           Index Cond: (s.row_id > 2)
                     ->  Index Only Scan using delete_t_pkey on union_all_required_columns_test.delete_t d
                           Output: d.row_id
(16 rows)

-- WHERE + ORDER BY + LIMIT: retain the global Limit and add one Limit per
-- branch.  Snapshot deletion filtering remains below its branch Limit.
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2
ORDER BY embedding <-> '[0,0,0,0]'
LIMIT 4;
                                                      QUERY PLAN                                                       
-----------------------------------------------------------------------------------------------------------------------
 Limit
   Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
   ->  Result
         Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
         ->  Merge Append
               Sort Key: ((delta_t.embedding <-> '[0,0,0,0]'::vector))
               ->  Limit
                     Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
                     ->  Sort
                           Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
                           Sort Key: ((delta_t.embedding <-> '[0,0,0,0]'::vector))
                           ->  Index Scan using delta_t_pkey on union_all_required_columns_test.delta_t
                                 Output: delta_t.row_id, (delta_t.embedding <-> '[0,0,0,0]'::vector)
                                 Index Cond: (delta_t.row_id > 2)
               ->  Limit
                     Output: s.row_id, ((s.embedding <-> '[0,0,0,0]'::vector))
                     ->  Sort
                           Output: s.row_id, ((s.embedding <-> '[0,0,0,0]'::vector))
                           Sort Key: ((s.embedding <-> '[0,0,0,0]'::vector))
                           ->  Merge Anti Join
                                 Output: s.row_id, (s.embedding <-> '[0,0,0,0]'::vector)
                                 Merge Cond: (s.row_id = d.row_id)
                                 ->  Index Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t s
                                       Output: s.row_id, s.embedding
                                       Index Cond: (s.row_id > 2)
                                 ->  Index Only Scan using delete_t_pkey on union_all_required_columns_test.delete_t d
                                       Output: d.row_id
(27 rows)

-- A non-indexed predicate gives the delta branch a representative DiskANN
-- plan.  title is legal in Filter but must not occur in any Output list.
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE title IS NOT NULL
ORDER BY embedding <-> '[0,0,0,0]'
LIMIT 4;
                                                      QUERY PLAN                                                       
-----------------------------------------------------------------------------------------------------------------------
 Limit
   Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
   ->  Result
         Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
         ->  Merge Append
               Sort Key: ((delta_t.embedding <-> '[0,0,0,0]'::vector))
               ->  Limit
                     Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
                     ->  Ann Index Scan using delta_embedding_diskann on union_all_required_columns_test.delta_t
                           Output: delta_t.row_id, (delta_t.embedding <-> '[0,0,0,0]'::vector)
                           Order By: (delta_t.embedding <-> '[0,0,0,0]'::vector)
                           Filter Mode: Post-Filter
                           Filter: (delta_t.title IS NOT NULL)
               ->  Limit
                     Output: s.row_id, ((s.embedding <-> '[0,0,0,0]'::vector))
                     ->  Sort
                           Output: s.row_id, ((s.embedding <-> '[0,0,0,0]'::vector))
                           Sort Key: ((s.embedding <-> '[0,0,0,0]'::vector))
                           ->  Merge Anti Join
                                 Output: s.row_id, (s.embedding <-> '[0,0,0,0]'::vector)
                                 Merge Cond: (s.row_id = d.row_id)
                                 ->  Index Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t s
                                       Output: s.row_id, s.embedding
                                       Filter: (s.title IS NOT NULL)
                                 ->  Index Only Scan using delete_t_pkey on union_all_required_columns_test.delete_t d
                                       Output: d.row_id
(26 rows)

-- A delete-side filter column ends at its scan Filter.  Only d.row_id reaches
-- the Anti Join; unused_delete never enters a plan Output list.
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view_delete_filter
WHERE title <> 'never';
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Result
   Output: delta_t.row_id
   ->  Append
         ->  Seq Scan on union_all_required_columns_test.delta_t
               Output: delta_t.row_id
               Filter: (delta_t.title <> 'never'::text)
         ->  Merge Anti Join
               Output: s.row_id
               Merge Cond: (s.row_id = d.row_id)
               ->  Index Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t s
                     Output: s.row_id
                     Filter: (s.title <> 'never'::text)
               ->  Materialize
                     Output: d.row_id
                     ->  Index Scan using delete_t_pkey on union_all_required_columns_test.delete_t d
                           Output: d.row_id
                           Filter: (d.reason = 'deleted'::text)
(17 rows)

-- Required-column pruning remains active without branch Top-K.  There is one
-- global Limit and the UNION still transports a scalar distance.
SET enable_union_all_diskann_topk_pushdown = off;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2
ORDER BY embedding <-> '[0,0,0,0]'
LIMIT 4;
                                                   QUERY PLAN                                                    
-----------------------------------------------------------------------------------------------------------------
 Limit
   Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
   ->  Sort
         Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
         Sort Key: ((delta_t.embedding <-> '[0,0,0,0]'::vector))
         ->  Result
               Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
               ->  Append
                     ->  Index Scan using delta_t_pkey on union_all_required_columns_test.delta_t
                           Output: delta_t.row_id, (delta_t.embedding <-> '[0,0,0,0]'::vector)
                           Index Cond: (delta_t.row_id > 2)
                     ->  Merge Anti Join
                           Output: s.row_id, (s.embedding <-> '[0,0,0,0]'::vector)
                           Merge Cond: (s.row_id = d.row_id)
                           ->  Index Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t s
                                 Output: s.row_id, s.embedding
                                 Index Cond: (s.row_id > 2)
                           ->  Index Only Scan using delete_t_pkey on union_all_required_columns_test.delete_t d
                                 Output: d.row_id
(19 rows)

SET enable_union_all_diskann_topk_pushdown = on;
-- Disabling the new GUC is a guarded compatibility path: original wide leaf
-- outputs and Subquery Scan boundaries remain visible.
SET enable_union_all_required_columns_pushdown = off;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2
ORDER BY embedding <-> '[0,0,0,0]'
LIMIT 4;
                                                                    QUERY PLAN                                                                     
---------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: "*SELECT* 1".row_id, (("*SELECT* 1".embedding <-> '[0,0,0,0]'::vector))
   ->  Sort
         Output: "*SELECT* 1".row_id, (("*SELECT* 1".embedding <-> '[0,0,0,0]'::vector))
         Sort Key: (("*SELECT* 1".embedding <-> '[0,0,0,0]'::vector))
         ->  Result
               Output: "*SELECT* 1".row_id, ("*SELECT* 1".embedding <-> '[0,0,0,0]'::vector)
               ->  Append
                     ->  Subquery Scan on "*SELECT* 1"
                           Output: "*SELECT* 1".row_id, "*SELECT* 1".embedding
                           Filter: ("*SELECT* 1".row_id > 2)
                           ->  Limit
                                 Output: delta_t.row_id, delta_t.title, delta_t.embedding, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
                                 ->  Sort
                                       Output: delta_t.row_id, delta_t.title, delta_t.embedding, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
                                       Sort Key: ((delta_t.embedding <-> '[0,0,0,0]'::vector))
                                       ->  Index Scan using delta_t_pkey on union_all_required_columns_test.delta_t
                                             Output: delta_t.row_id, delta_t.title, delta_t.embedding, (delta_t.embedding <-> '[0,0,0,0]'::vector)
                                             Index Cond: (delta_t.row_id > 2)
                     ->  Subquery Scan on "*SELECT* 2"
                           Output: "*SELECT* 2".row_id, "*SELECT* 2".embedding
                           Filter: ("*SELECT* 2".row_id > 2)
                           ->  Limit
                                 Output: s.row_id, s.title, s.embedding, ((s.embedding <-> '[0,0,0,0]'::vector))
                                 ->  Sort
                                       Output: s.row_id, s.title, s.embedding, ((s.embedding <-> '[0,0,0,0]'::vector))
                                       Sort Key: ((s.embedding <-> '[0,0,0,0]'::vector))
                                       ->  Merge Anti Join
                                             Output: s.row_id, s.title, s.embedding, (s.embedding <-> '[0,0,0,0]'::vector)
                                             Merge Cond: (s.row_id = d.row_id)
                                             ->  Index Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t s
                                                   Output: s.row_id, s.title, s.embedding
                                                   Index Cond: (s.row_id > 2)
                                             ->  Index Only Scan using delete_t_pkey on union_all_required_columns_test.delete_t d
                                                   Output: d.row_id
(35 rows)

SET enable_union_all_required_columns_pushdown = on;
-- A nested four-leaf UNION ALL guards recursive SetOperationStmt metadata
-- compaction and non-contiguous column renumbering.
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM
(
    SELECT row_id, title, embedding FROM delta_t WHERE row_id < 101
    UNION ALL
    SELECT row_id, title, embedding FROM delta_t WHERE row_id >= 101
    UNION ALL
    SELECT row_id, title, embedding FROM snapshot_t WHERE row_id < 3
    UNION ALL
    SELECT row_id, title, embedding FROM snapshot_t WHERE row_id >= 3
) u
WHERE row_id > 0;
                                                                    QUERY PLAN                                                                    
--------------------------------------------------------------------------------------------------------------------------------------------------
 Result
   Output: union_all_required_columns_test.delta_t.row_id
   ->  Append
         ->  Index Only Scan using delta_t_pkey on union_all_required_columns_test.delta_t
               Output: union_all_required_columns_test.delta_t.row_id
               Index Cond: ((union_all_required_columns_test.delta_t.row_id < 101) AND (union_all_required_columns_test.delta_t.row_id > 0))
         ->  Index Only Scan using delta_t_pkey on union_all_required_columns_test.delta_t
               Output: union_all_required_columns_test.delta_t.row_id
               Index Cond: ((union_all_required_columns_test.delta_t.row_id >= 101) AND (union_all_required_columns_test.delta_t.row_id > 0))
         ->  Index Only Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t
               Output: union_all_required_columns_test.snapshot_t.row_id
               Index Cond: ((union_all_required_columns_test.snapshot_t.row_id < 3) AND (union_all_required_columns_test.snapshot_t.row_id > 0))
         ->  Index Only Scan using snapshot_t_pkey on union_all_required_columns_test.snapshot_t
               Output: union_all_required_columns_test.snapshot_t.row_id
               Index Cond: ((union_all_required_columns_test.snapshot_t.row_id >= 3) AND (union_all_required_columns_test.snapshot_t.row_id > 0))
(15 rows)

