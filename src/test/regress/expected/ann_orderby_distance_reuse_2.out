         Output: id, ((embedding <-> '[11,23,35,47]'::vector))
         Order By: (ann_l2_t.embedding <-> '[11,23,35,47]'::vector)
         Filter: (ann_l2_t.title IS NOT NULL)
         Rows Removed by Filter: 1
--? Total runtime: .* ms
