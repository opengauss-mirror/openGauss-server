-- A Join may pass the approximate value through, but may not consume it to
-- decide matches or filter rows.  This outer Join reads the subquery distance
-- in its join condition, so the nested Ann Index Scan must retain the exact
-- single-parenthesized projection.
CREATE TABLE cosine_gate(max_distance float8);
INSERT INTO cosine_gate VALUES (2.0);
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT q.row_id
FROM
(
    SELECT row_id, embedding <=> '[1,1,1,1]' AS distance
    FROM delta_t
    WHERE row_id > 2
    ORDER BY embedding <=> '[1,1,1,1]'
    LIMIT 4
) q
JOIN cosine_gate g ON q.distance < g.max_distance
ORDER BY q.distance
LIMIT 4;
                                                QUERY PLAN                                                
----------------------------------------------------------------------------------------------------------
 Limit
   Output: delta_t.row_id, ((delta_t.embedding <=> '[1,1,1,1]'::vector))
   ->  Nested Loop
         Output: delta_t.row_id, ((delta_t.embedding <=> '[1,1,1,1]'::vector))
         Join Filter: (((delta_t.embedding <=> '[1,1,1,1]'::vector)) < g.max_distance)
         ->  Limit
               Output: delta_t.row_id, ((delta_t.embedding <=> '[1,1,1,1]'::vector))
               ->  Ann Index Scan using delta_cosine_diskann on union_all_ann_feature_matrix_test.delta_t
                     Output: delta_t.row_id, (delta_t.embedding <=> '[1,1,1,1]'::vector)
                     Order By: (delta_t.embedding <=> '[1,1,1,1]'::vector)
                     Filter: (delta_t.row_id > 2)
         ->  Materialize
               Output: g.max_distance
               ->  Seq Scan on union_all_ann_feature_matrix_test.cosine_gate g
                     Output: g.max_distance
(15 rows)

-- <+> is L1 in this openGauss tree, not cosine.  With every requested
-- feature enabled it must remain outside both DiskANN cosine Top-K pushdown
-- and cosine AM-distance reuse.
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2
ORDER BY embedding <+> '[0,0,0,0]'
LIMIT 4;
                                           QUERY PLAN                                           
------------------------------------------------------------------------------------------------
 Limit
   Output: delta_t.row_id, ((delta_t.embedding <+> '[0,0,0,0]'::vector))
   ->  Sort
         Output: delta_t.row_id, ((delta_t.embedding <+> '[0,0,0,0]'::vector))
         Sort Key: ((delta_t.embedding <+> '[0,0,0,0]'::vector))
         ->  Result
               Output: delta_t.row_id, ((delta_t.embedding <+> '[0,0,0,0]'::vector))
               ->  Append
                     ->  Seq Scan on union_all_ann_feature_matrix_test.delta_t
                           Output: delta_t.row_id, (delta_t.embedding <+> '[0,0,0,0]'::vector)
                           Filter: (delta_t.row_id > 2)
                     ->  Merge Anti Join
                           Output: s.row_id, (s.embedding <+> '[0,0,0,0]'::vector)
                           Merge Cond: (s.row_id = d.row_id)
                           ->  Sort
                                 Output: s.row_id, s.embedding
                                 Sort Key: s.row_id
                                 ->  Seq Scan on union_all_ann_feature_matrix_test.snapshot_t s
                                       Output: s.row_id, s.embedding
                                       Filter: (s.row_id > 2)
                           ->  Sort
                                 Output: d.row_id
                                 Sort Key: d.row_id
                                 ->  Seq Scan on union_all_ann_feature_matrix_test.delete_t d
                                       Output: d.row_id
(25 rows)

-- P1: a whole-row RECORD hides the float8 distance dependency.  Both join
-- conditions and NestLoop parameters must fail closed, including after
-- setrefs has placed that whole-row value in an ordinary output slot.
-- LIMIT exceeds the eight candidates: a missing row is not Top-K truncation.
CREATE TABLE join_guard_t(id integer, embedding vector(4));
INSERT INTO join_guard_t
SELECT g, ('[' || (g+1) || ',' || (2*g+3) || ',' ||
           (3*g+5) || ',' || (4*g+7) || ']')::vector
FROM generate_series(1,8) g;
CREATE INDEX join_guard_cos ON join_guard_t
USING diskann(embedding vector_cosine_ops) WITH(index_size=16);
CREATE TABLE join_guard_gates(id integer);
INSERT INTO join_guard_gates SELECT generate_series(1,8);
ANALYZE join_guard_t;
ANALYZE join_guard_gates;
SET enable_union_all_diskann_topk_pushdown=off;
SET enable_union_all_required_columns_pushdown=off;
SET enable_expr_fusion=off;
SET enable_hashjoin=off;
SET enable_mergejoin=off;
SET enable_nestloop=on;
SET ann_orderby_distance_reuse=cosine;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT q.id, q.distance FROM (SELECT id, embedding <=> '[11,23,35,47]'::vector AS distance
 FROM join_guard_t ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q
JOIN join_guard_gates g ON q = ROW(g.id, cosine_distance('[2,5,8,11]'::vector, '[11,23,35,47]'::vector)) ORDER BY q.distance;
                                               QUERY PLAN                                                
---------------------------------------------------------------------------------------------------------
 Nested Loop
   Output: q.id, q.distance
   Join Filter: (q.* = ROW(g.id, .000927228781839928::double precision))
   ->  Subquery Scan on q
         Output: q.id, q.distance, q.*
         ->  Limit
               Output: join_guard_t.id, ((join_guard_t.embedding <=> '[11,23,35,47]'::vector))
               ->  Ann Index Scan using join_guard_cos on union_all_ann_feature_matrix_test.join_guard_t
                     Output: join_guard_t.id, (join_guard_t.embedding <=> '[11,23,35,47]'::vector)
                     Order By: (join_guard_t.embedding <=> '[11,23,35,47]'::vector)
   ->  Materialize
         Output: g.id
         ->  Seq Scan on union_all_ann_feature_matrix_test.join_guard_gates g
               Output: g.id
(14 rows)

SET enable_mergejoin=on;
SET enable_nestloop=off;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT q.id, q.distance FROM (SELECT id, embedding <=> '[11,23,35,47]'::vector AS distance
 FROM join_guard_t ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q
JOIN join_guard_gates g ON q = ROW(g.id, cosine_distance('[2,5,8,11]'::vector, '[11,23,35,47]'::vector)) ORDER BY q.distance;
                                                     QUERY PLAN                                                      
---------------------------------------------------------------------------------------------------------------------
 Sort
   Output: q.id, q.distance
   Sort Key: q.distance
   ->  Merge Join
         Output: q.id, q.distance
         Merge Cond: (q.* = (ROW(g.id, .000927228781839928::double precision)))
         ->  Sort
               Output: q.id, q.distance, q.*
               Sort Key: q.*
               ->  Subquery Scan on q
                     Output: q.id, q.distance, q.*
                     ->  Limit
                           Output: join_guard_t.id, ((join_guard_t.embedding <=> '[11,23,35,47]'::vector))
                           ->  Ann Index Scan using join_guard_cos on union_all_ann_feature_matrix_test.join_guard_t
                                 Output: join_guard_t.id, (join_guard_t.embedding <=> '[11,23,35,47]'::vector)
                                 Order By: (join_guard_t.embedding <=> '[11,23,35,47]'::vector)
         ->  Sort
               Output: g.id, (ROW(g.id, .000927228781839928::double precision))
               Sort Key: (ROW(g.id, .000927228781839928::double precision))
               ->  Seq Scan on union_all_ann_feature_matrix_test.join_guard_gates g
                     Output: g.id, ROW(g.id, .000927228781839928::double precision)
(21 rows)

SET enable_mergejoin=off;
SET enable_nestloop=on;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT q.id, q.distance FROM (SELECT id, embedding <=> '[11,23,35,47]'::vector AS distance
 FROM join_guard_t ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q
CROSS JOIN LATERAL (SELECT g.id FROM join_guard_gates g
 WHERE q = ROW(g.id, cosine_distance('[2,5,8,11]'::vector, '[11,23,35,47]'::vector)) OFFSET 0) hit ORDER BY q.distance;
                                               QUERY PLAN                                                
---------------------------------------------------------------------------------------------------------
 Nested Loop
   Output: q.id, q.distance
   ->  Subquery Scan on q
         Output: q.id, q.distance, q.*
         ->  Limit
               Output: join_guard_t.id, ((join_guard_t.embedding <=> '[11,23,35,47]'::vector))
               ->  Ann Index Scan using join_guard_cos on union_all_ann_feature_matrix_test.join_guard_t
                     Output: join_guard_t.id, (join_guard_t.embedding <=> '[11,23,35,47]'::vector)
                     Order By: (join_guard_t.embedding <=> '[11,23,35,47]'::vector)
   ->  Limit
         Output: g.id
         ->  Seq Scan on union_all_ann_feature_matrix_test.join_guard_gates g
