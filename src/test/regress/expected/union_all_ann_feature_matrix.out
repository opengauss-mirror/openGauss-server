-- 32 small vectors with 4kB inline payloads force real Hash batches at 64kB.
-- The returned payload prevents pruning it away before the Hash build.
CREATE TABLE hash_payload_t(id integer,embedding vector(4),payload text);
ALTER TABLE hash_payload_t ALTER COLUMN payload SET STORAGE PLAIN;
INSERT INTO hash_payload_t
SELECT g,('['||(g+1)||','||(2*g+3)||','||(3*g+5)||','||(4*g+7)||']')::vector,
       repeat(md5(g::text),125) FROM generate_series(1,32) g;
CREATE INDEX hash_payload_cos ON hash_payload_t
USING diskann(embedding vector_cosine_ops) WITH(index_size=64);
CREATE INDEX hash_payload_l2 ON hash_payload_t
USING diskann(embedding vector_l2_ops) WITH(index_size=64);
CREATE TABLE hash_payload_gates AS SELECT id FROM hash_payload_t;
CREATE TABLE hash_rounds(n integer);
INSERT INTO hash_rounds VALUES(0),(1),(2);
ANALYZE hash_payload_t;
ANALYZE hash_payload_gates;
ANALYZE hash_rounds;
CREATE TABLE hash_lifecycle_cases(label text, mem text, query_text text);
INSERT INTO hash_lifecycle_cases VALUES ('in_memory','4MB',$q$
SELECT /*+ leading((g q)) hashjoin(g q) */ q.id,q.distance,q.payload
FROM hash_payload_gates g JOIN
 (SELECT id,embedding <=> '[11,23,35,47]'::vector AS distance,payload
  FROM hash_payload_t ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 80) q
ON q.id=g.id$q$);
INSERT INTO hash_lifecycle_cases
SELECT 'spill','64kB',query_text FROM hash_lifecycle_cases WHERE label='in_memory';
INSERT INTO hash_lifecycle_cases VALUES ('rescan','64kB',$q$
SELECT r.id,r.distance,r.payload FROM hash_rounds p CROSS JOIN LATERAL
 (SELECT /*+ leading((g q)) hashjoin(g q) */ q.id,q.distance,q.payload
  FROM hash_payload_gates g JOIN
   (SELECT id,embedding <=> '[11,23,35,47]'::vector AS distance,payload
    FROM hash_payload_t WHERE id>p.n
    ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 80) q
  ON q.id=g.id OFFSET 0) r$q$);
CREATE FUNCTION hash_lifecycle_check(reuse_mode text)
RETURNS TABLE(scenario text, row_count bigint, rows_ok boolean, values_ok boolean,
              hash_seen boolean, batched boolean, rescanned boolean, ref_scans integer) AS $$
DECLARE
    c record; query_text text; baseline text; line text; expected_rows bigint;
    off_ids text; on_ids text; saved_mem text:=current_setting('work_mem');
    awaiting_output boolean;
BEGIN
    baseline:='SELECT id,embedding <=> ''[11,23,35,47]''::vector AS distance,payload '
              || 'FROM hash_payload_t ORDER BY embedding <=> ''[11,23,35,47]''::vector LIMIT 80';
    IF reuse_mode='l2' THEN baseline:=replace(baseline,'<=>','<->'); END IF;
    FOR c IN SELECT * FROM hash_lifecycle_cases ORDER BY label LOOP
        PERFORM set_config('work_mem',c.mem,true);
        query_text:=c.query_text;
        IF reuse_mode='l2' THEN query_text:=replace(query_text,'<=>','<->'); END IF;
        expected_rows:=CASE WHEN c.label='rescan' THEN 93 ELSE 32 END;
        PERFORM set_config('ann_orderby_distance_reuse','off',true);
        SELECT array_agg(r.id ORDER BY r.id)::text INTO off_ids
          FROM join_guard_capture(query_text) r(id integer,distance float8,payload text);
        PERFORM set_config('ann_orderby_distance_reuse',reuse_mode,true);
        SELECT count(*),array_agg(r.id ORDER BY r.id)::text,
               bool_and(float8send(r.distance)=float8send(b.distance) AND r.payload=b.payload)
          INTO row_count,on_ids,values_ok
          FROM join_guard_capture(query_text) r(id integer,distance float8,payload text)
          JOIN join_guard_capture(baseline) b(id integer,distance float8,payload text) ON r.id=b.id;
        rows_ok:=(off_ids IS NOT DISTINCT FROM on_ids) AND row_count=expected_rows;
        hash_seen:=false; batched:=false; rescanned:=false;
        ref_scans:=0; awaiting_output:=false;
        -- Observe the real execution path, rather than assuming low memory
        -- caused batching or that LATERAL caused a Hash rebuild.
        FOR line IN EXECUTE 'EXPLAIN (ANALYZE,VERBOSE,COSTS OFF,TIMING OFF) ' || query_text LOOP
            IF line ~ 'Hash \(actual' THEN
                hash_seen:=true;
                IF substring(line FROM 'loops=([0-9]+)')::integer>1 THEN rescanned:=true; END IF;
            END IF;
            IF substring(line FROM 'Batches: ([0-9]+)')::integer>1 THEN batched:=true; END IF;
            IF position('Ann Index Scan' IN line)>0 THEN
                awaiting_output:=true;
            ELSIF awaiting_output AND position('Output:' IN line)>0 THEN
                IF position('((' IN line)>0 THEN ref_scans:=ref_scans+1; END IF;
                awaiting_output:=false;
            END IF;
        END LOOP;
        scenario:=c.label;
        RETURN NEXT;
    END LOOP;
    PERFORM set_config('work_mem',saved_mem,true);
END;
$$ LANGUAGE plpgsql;
SET enable_material=off;
SET enable_expr_fusion=off;
SELECT * FROM hash_lifecycle_check('cosine') ORDER BY scenario;
