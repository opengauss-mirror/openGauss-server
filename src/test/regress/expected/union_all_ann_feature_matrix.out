         ->  Limit
               Output: join_guard_t.id, ((join_guard_t.embedding <=> '[11,23,35,47]'::vector))
               ->  Ann Index Scan using join_guard_cos on union_all_ann_feature_matrix_test.join_guard_t
                     Output: join_guard_t.id, ((join_guard_t.embedding <=> '[11,23,35,47]'::vector))
