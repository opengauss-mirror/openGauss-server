-- UNION ALL Top-K, required-column pruning, and DiskANN distance reuse.
-- Each distance family is planned in four cumulative GUC stages.
SET client_min_messages = warning;
DROP SCHEMA IF EXISTS union_all_ann_feature_matrix_test CASCADE;
CREATE SCHEMA union_all_ann_feature_matrix_test;
SET search_path = union_all_ann_feature_matrix_test, public;
-- Deliberately omit row_id indexes.  This keeps the snapshot Anti Join on the
-- Sort -> scan shape that previously exposed shared-targetlist corruption.
CREATE TABLE delta_t
(
    row_id bigint,
    title text,
    embedding vector(4)
);
CREATE TABLE snapshot_t
(
    row_id bigint,
    title text,
    embedding vector(4)
);
CREATE TABLE delete_t
(
    row_id bigint
);
INSERT INTO delta_t VALUES
    (3,   'delta-3',   '[3.25,1,1,1]'),
    (101, 'delta-101', '[1.5,2,3,4]'),
    (102, 'delta-102', '[2.5,3,4,5]'),
    (103, 'delta-103', '[3.5,4,5,6]'),
    (104, 'delta-104', '[4.5,5,6,7]'),
    (105, 'delta-105', '[5.5,6,7,8]'),
    (106, 'delta-106', '[6.5,7,8,9]');
INSERT INTO snapshot_t VALUES
    (1, 'snapshot-1', '[1,1,2,3]'),
    (2, 'snapshot-2', '[2,2,3,4]'),
    (3, 'snapshot-3', '[3,3,4,5]'),
    (4, 'snapshot-4', '[4,4,5,6]'),
    (5, 'snapshot-5', '[5,5,6,7]'),
    (6, 'snapshot-6', '[6,6,7,8]');
INSERT INTO delete_t VALUES (2), (5), (99);
CREATE INDEX delta_l2_diskann ON delta_t
    USING diskann (embedding vector_l2_ops);
CREATE INDEX snapshot_l2_diskann ON snapshot_t
    USING diskann (embedding vector_l2_ops);
CREATE INDEX delta_cosine_diskann ON delta_t
    USING diskann (embedding vector_cosine_ops);
CREATE INDEX snapshot_cosine_diskann ON snapshot_t
    USING diskann (embedding vector_cosine_ops);
CREATE VIEW union_view AS
SELECT row_id, title, embedding
FROM delta_t
UNION ALL
SELECT s.row_id, s.title, s.embedding
FROM snapshot_t s
WHERE NOT EXISTS
(
    SELECT 1
    FROM delete_t d
    WHERE d.row_id = s.row_id
);
ANALYZE delta_t;
ANALYZE snapshot_t;
ANALYZE delete_t;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = on;
SET enable_nestloop = off;
-- -------------------------------------------------------------------------
-- L2: all off -> Top-K -> required columns -> exact L2 distance reuse.
-- -------------------------------------------------------------------------
SET enable_union_all_diskann_topk_pushdown = off;
SET enable_union_all_required_columns_pushdown = off;
SET ann_orderby_distance_reuse = off;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2
ORDER BY embedding <-> '[0,0,0,0]'
LIMIT 4;
                                                           QUERY PLAN                                                            
---------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
   ->  Result
         Output: delta_t.row_id, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
         ->  Merge Append
               Sort Key: ((delta_t.embedding <-> '[0,0,0,0]'::vector))
               ->  Ann Index Scan using delta_l2_diskann on union_all_ann_feature_matrix_test.delta_t
                     Output: delta_t.row_id, delta_t.embedding, (delta_t.embedding <-> '[0,0,0,0]'::vector)
                     Order By: (delta_t.embedding <-> '[0,0,0,0]'::vector)
                     Filter: (delta_t.row_id > 2)
               ->  Sort
                     Output: "*SELECT* 2".row_id, "*SELECT* 2".embedding, (("*SELECT* 2".embedding <-> '[0,0,0,0]'::vector))
                     Sort Key: (("*SELECT* 2".embedding <-> '[0,0,0,0]'::vector))
                     ->  Subquery Scan on "*SELECT* 2"
                           Output: "*SELECT* 2".row_id, "*SELECT* 2".embedding, ("*SELECT* 2".embedding <-> '[0,0,0,0]'::vector)
                           ->  Merge Anti Join
                                 Output: s.row_id, s.title, s.embedding
                                 Merge Cond: (s.row_id = d.row_id)
                                 ->  Sort
                                       Output: s.row_id, s.title, s.embedding
                                       Sort Key: s.row_id
                                       ->  Seq Scan on union_all_ann_feature_matrix_test.snapshot_t s
                                             Output: s.row_id, s.title, s.embedding
                                             Filter: (s.row_id > 2)
                                 ->  Sort
                                       Output: d.row_id
                                       Sort Key: d.row_id
                                       ->  Seq Scan on union_all_ann_feature_matrix_test.delete_t d
                                             Output: d.row_id
(29 rows)

SET enable_union_all_diskann_topk_pushdown = on;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2
ORDER BY embedding <-> '[0,0,0,0]'
LIMIT 4;
                                                                    QUERY PLAN                                                                    
--------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: "*SELECT* 1".row_id, (("*SELECT* 1".embedding <-> '[0,0,0,0]'::vector))
   ->  Sort
         Output: "*SELECT* 1".row_id, (("*SELECT* 1".embedding <-> '[0,0,0,0]'::vector))
         Sort Key: (("*SELECT* 1".embedding <-> '[0,0,0,0]'::vector))
         ->  Result
               Output: "*SELECT* 1".row_id, ("*SELECT* 1".embedding <-> '[0,0,0,0]'::vector)
               ->  Append
                     ->  Subquery Scan on "*SELECT* 1"
                           Output: "*SELECT* 1".row_id, "*SELECT* 1".embedding
                           Filter: ("*SELECT* 1".row_id > 2)
                           ->  Limit
                                 Output: delta_t.row_id, delta_t.title, delta_t.embedding, ((delta_t.embedding <-> '[0,0,0,0]'::vector))
                                 ->  Ann Index Scan using delta_l2_diskann on union_all_ann_feature_matrix_test.delta_t
                                       Output: delta_t.row_id, delta_t.title, delta_t.embedding, (delta_t.embedding <-> '[0,0,0,0]'::vector)
                                       Order By: (delta_t.embedding <-> '[0,0,0,0]'::vector)
                                       Filter: (delta_t.row_id > 2)
                     ->  Subquery Scan on "*SELECT* 2"
                           Output: "*SELECT* 2".row_id, "*SELECT* 2".embedding
                           Filter: ("*SELECT* 2".row_id > 2)
                           ->  Limit
                                 Output: s.row_id, s.title, s.embedding, ((s.embedding <-> '[0,0,0,0]'::vector))
                                 ->  Sort
                                       Output: s.row_id, s.title, s.embedding, ((s.embedding <-> '[0,0,0,0]'::vector))
                                       Sort Key: ((s.embedding <-> '[0,0,0,0]'::vector))
                                       ->  Merge Anti Join
                                             Output: s.row_id, s.title, s.embedding, (s.embedding <-> '[0,0,0,0]'::vector)
                                             Merge Cond: (s.row_id = d.row_id)
                                             ->  Sort
                                                   Output: s.row_id, s.title, s.embedding
                                                   Sort Key: s.row_id
                                                   ->  Ann Index Scan using snapshot_l2_diskann on union_all_ann_feature_matrix_test.snapshot_t s
                                                         Output: s.row_id, s.title, s.embedding
                                                         Order By: (s.embedding <-> '[0,0,0,0]'::vector)
                                                         Filter: (s.row_id > 2)
                                             ->  Sort
                                                   Output: d.row_id
                                                   Sort Key: d.row_id
                                                   ->  Seq Scan on union_all_ann_feature_matrix_test.delete_t d
                                                         Output: d.row_id
(40 rows)

