         ->  Hash
               Output: g.id
               ->  Seq Scan on union_all_ann_feature_matrix_test.join_guard_gates g
                     Output: g.id
(15 rows)

SET enable_union_all_diskann_topk_pushdown=on;
SET enable_union_all_required_columns_pushdown=on;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id FROM union_view WHERE row_id>2
ORDER BY embedding <=> '[1,1,1,1]'::vector LIMIT 4;
                                                                QUERY PLAN                                                                
------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: delta_t.row_id, ((delta_t.embedding <=> '[1,1,1,1]'::vector))
   ->  Result
         Output: delta_t.row_id, ((delta_t.embedding <=> '[1,1,1,1]'::vector))
         ->  Merge Append
               Sort Key: ((delta_t.embedding <=> '[1,1,1,1]'::vector))
               ->  Limit
                     Output: delta_t.row_id, ((delta_t.embedding <=> '[1,1,1,1]'::vector))
                     ->  Ann Index Scan using delta_cosine_diskann on union_all_ann_feature_matrix_test.delta_t
                           Output: delta_t.row_id, ((delta_t.embedding <=> '[1,1,1,1]'::vector))
                           Order By: (delta_t.embedding <=> '[1,1,1,1]'::vector)
                           Filter: (delta_t.row_id > 2)
               ->  Limit
                     Output: s.row_id, ((s.embedding <=> '[1,1,1,1]'::vector))
                     ->  Sort
                           Output: s.row_id, ((s.embedding <=> '[1,1,1,1]'::vector))
                           Sort Key: ((s.embedding <=> '[1,1,1,1]'::vector))
                           ->  Hash Right Anti Join
                                 Output: s.row_id, ((s.embedding <=> '[1,1,1,1]'::vector))
                                 Hash Cond: (d.row_id = s.row_id)
                                 ->  Seq Scan on union_all_ann_feature_matrix_test.delete_t d
                                       Output: d.row_id
                                 ->  Hash
                                       Output: s.row_id, ((s.embedding <=> '[1,1,1,1]'::vector))
                                       ->  Ann Index Scan using snapshot_cosine_diskann on union_all_ann_feature_matrix_test.snapshot_t s
                                             Output: s.row_id, ((s.embedding <=> '[1,1,1,1]'::vector))
                                             Order By: (s.embedding <=> '[1,1,1,1]'::vector)
                                             Filter: (s.row_id > 2)
(28 rows)

SET enable_union_all_diskann_topk_pushdown=off;
SET enable_union_all_required_columns_pushdown=off;
CREATE TABLE hash_guard_gates AS
SELECT id, cosine_distance(embedding,'[11,23,35,47]'::vector) AS distance
FROM join_guard_t;
CREATE TABLE hash_extra_gates(id integer);
INSERT INTO hash_extra_gates VALUES(1),(1),(2),(9);
ANALYZE hash_guard_gates;
ANALYZE hash_extra_gates;
CREATE TABLE hash_guard_cases(label text, query_text text);
INSERT INTO hash_guard_cases VALUES ('build', $q$
SELECT /*+ leading((g q)) hashjoin(g q) */ q.id,q.distance
FROM hash_guard_gates g JOIN
 (SELECT id,embedding <=> '[11,23,35,47]'::vector AS distance FROM join_guard_t
  ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q ON q.id=g.id$q$);
INSERT INTO hash_guard_cases VALUES ('probe', $q$
SELECT /*+ leading((q g)) hashjoin(q g) */ q.id,q.distance
FROM (SELECT id,embedding <=> '[11,23,35,47]'::vector AS distance FROM join_guard_t
 ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q
JOIN hash_guard_gates g ON q.id=g.id$q$);
INSERT INTO hash_guard_cases VALUES ('distance_key', $q$
SELECT /*+ leading((g q)) hashjoin(g q) */ q.id,q.distance
FROM hash_guard_gates g JOIN
 (SELECT id,embedding <=> '[11,23,35,47]'::vector AS distance FROM join_guard_t
  ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q
ON q.id=g.id AND q.distance=g.distance$q$);
INSERT INTO hash_guard_cases VALUES ('distance_filter', $q$
SELECT /*+ leading((g q)) hashjoin(g q) */ q.id,q.distance
FROM hash_guard_gates g JOIN
 (SELECT id,embedding <=> '[11,23,35,47]'::vector AS distance FROM join_guard_t
  ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q
ON q.id=g.id AND q.distance>=g.distance AND q.distance<=g.distance$q$);
INSERT INTO hash_guard_cases VALUES ('record_filter', $q$
SELECT /*+ leading((g q)) hashjoin(g q) */ q.id,q.distance
FROM hash_guard_gates g JOIN
 (SELECT id,embedding <=> '[11,23,35,47]'::vector AS distance FROM join_guard_t
  ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q
ON q.id=g.id AND q=ROW(g.id,g.distance)$q$);
-- Unsafe first branch must not turn off its safe sibling (or vice versa).
INSERT INTO hash_guard_cases
SELECT 'siblings', a.query_text || ' UNION ALL ' || b.query_text
FROM hash_guard_cases a, hash_guard_cases b
WHERE a.label='record_filter' AND b.label='build';
INSERT INTO hash_guard_cases
SELECT 'siblings_reverse', a.query_text || ' UNION ALL ' || b.query_text
FROM hash_guard_cases a, hash_guard_cases b
WHERE a.label='build' AND b.label='record_filter';
INSERT INTO hash_guard_cases VALUES ('duplicates', $q$
SELECT /*+ leading((g q)) hashjoin(g q) */ q.id,q.distance
FROM hash_extra_gates g JOIN
 (SELECT id,embedding <=> '[11,23,35,47]'::vector AS distance FROM join_guard_t
  ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q ON q.id=g.id$q$);
INSERT INTO hash_guard_cases VALUES ('left_null', $q$
SELECT /*+ leading((g q)) hashjoin(g q) */ g.id,q.distance
FROM hash_extra_gates g LEFT JOIN
 (SELECT id,embedding <=> '[11,23,35,47]'::vector AS distance FROM join_guard_t
  ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q ON q.id=g.id$q$);
INSERT INTO hash_guard_cases VALUES ('empty_build', $q$
SELECT /*+ leading((g q)) hashjoin(g q) */ g.id,q.distance
FROM hash_extra_gates g LEFT JOIN
 (SELECT id,embedding <=> '[11,23,35,47]'::vector AS distance FROM join_guard_t
  WHERE id>100 ORDER BY embedding <=> '[11,23,35,47]'::vector LIMIT 40) q ON q.id=g.id$q$);
CREATE FUNCTION hash_guard_check()
RETURNS TABLE(scenario text, rows_off bigint, rows_on bigint, same_ids boolean,
              null_rows bigint, hash_joins integer, ref_scans integer, approximate_rows bigint) AS $$
DECLARE
    c record; line text; awaiting_output boolean;
    off_ids text; on_ids text; off_nulls bigint;
BEGIN
    FOR c IN SELECT * FROM hash_guard_cases ORDER BY label LOOP
        PERFORM set_config('ann_orderby_distance_reuse','off',true);
        SELECT count(*),array_agg(r.id ORDER BY r.id)::text,
               sum(CASE WHEN r.distance IS NULL THEN 1 ELSE 0 END)
          INTO rows_off,off_ids,off_nulls
          FROM join_guard_capture(c.query_text) r(id integer,distance float8);
        PERFORM set_config('ann_orderby_distance_reuse','cosine',true);
        SELECT count(*),array_agg(r.id ORDER BY r.id)::text,
               sum(CASE WHEN r.distance IS NULL THEN 1 ELSE 0 END),
               sum(CASE WHEN r.distance IS NOT NULL AND
                             float8send(r.distance) IS DISTINCT FROM float8send(t.distance)
                        THEN 1 ELSE 0 END) INTO rows_on,on_ids,null_rows,approximate_rows
          FROM join_guard_capture(c.query_text) r(id integer,distance float8)
          LEFT JOIN hash_guard_gates t ON t.id=r.id;
        hash_joins:=0; ref_scans:=0; awaiting_output:=false;
        FOR line IN EXECUTE 'EXPLAIN (VERBOSE ON,COSTS OFF) ' || c.query_text LOOP
            IF line ~ 'Hash (.* )?Join' THEN hash_joins:=hash_joins+1; END IF;
            IF position('Ann Index Scan' IN line)>0 THEN
                awaiting_output:=true;
            ELSIF awaiting_output AND position('Output:' IN line)>0 THEN
                IF position('((' IN line)>0 THEN ref_scans:=ref_scans+1; END IF;
                awaiting_output:=false;
            END IF;
        END LOOP;
        scenario:=c.label;
        same_ids:=(off_ids IS NOT DISTINCT FROM on_ids) AND (off_nulls IS NOT DISTINCT FROM null_rows);
        RETURN NEXT;
    END LOOP;
END;
$$ LANGUAGE plpgsql;
SET enable_expr_fusion=off;
