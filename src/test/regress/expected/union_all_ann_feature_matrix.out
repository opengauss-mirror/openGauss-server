-- -------------------------------------------------------------------------
-- Cosine: openGauss uses <=>.  A nonzero query vector is required because a
-- zero vector has no defined cosine direction.
-- -------------------------------------------------------------------------
SET enable_union_all_diskann_topk_pushdown = off;
SET enable_union_all_required_columns_pushdown = off;
SET ann_orderby_distance_reuse = off;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT row_id
FROM union_view
WHERE row_id > 2
ORDER BY embedding <=> '[1,1,1,1]'
LIMIT 4;
                                                           QUERY PLAN                                                            
---------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: delta_t.row_id, ((delta_t.embedding <=> '[1,1,1,1]'::vector))
   ->  Result
         Output: delta_t.row_id, ((delta_t.embedding <=> '[1,1,1,1]'::vector))
         ->  Merge Append
               Sort Key: ((delta_t.embedding <=> '[1,1,1,1]'::vector))
               ->  Ann Index Scan using delta_cosine_diskann on union_all_ann_feature_matrix_test.delta_t
                     Output: delta_t.row_id, delta_t.embedding, (delta_t.embedding <=> '[1,1,1,1]'::vector)
                     Order By: (delta_t.embedding <=> '[1,1,1,1]'::vector)
                     Filter: (delta_t.row_id > 2)
               ->  Sort
                     Output: "*SELECT* 2".row_id, "*SELECT* 2".embedding, (("*SELECT* 2".embedding <=> '[1,1,1,1]'::vector))
                     Sort Key: (("*SELECT* 2".embedding <=> '[1,1,1,1]'::vector))
                     ->  Subquery Scan on "*SELECT* 2"
                           Output: "*SELECT* 2".row_id, "*SELECT* 2".embedding, ("*SELECT* 2".embedding <=> '[1,1,1,1]'::vector)
                           ->  Merge Anti Join
                                 Output: s.row_id, s.title, s.embedding
                                 Merge Cond: (s.row_id = d.row_id)
                                 ->  Sort
                                       Output: s.row_id, s.title, s.embedding
                                       Sort Key: s.row_id
                                       ->  Seq Scan on union_all_ann_feature_matrix_test.snapshot_t s
                                             Output: s.row_id, s.title, s.embedding
                                             Filter: (s.row_id > 2)
                                 ->  Sort
                                       Output: d.row_id
                                       Sort Key: d.row_id
                                       ->  Seq Scan on union_all_ann_feature_matrix_test.delete_t d
                                             Output: d.row_id
(29 rows)

