   ->  Result
         Output: delta_t.id, delta_t.id, delta_t.id, delta_t.n1, delta_t.n2, delta_t.n3, delta_t.n4, ((delta_t.embedding <=> '[2,2,2,2]'::vector))
         ->  Merge Append
               Sort Key: ((delta_t.embedding <=> '[2,2,2,2]'::vector))
               ->  Limit
                     Output: delta_t.id, delta_t.n1, delta_t.n2, delta_t.n3, delta_t.n4, ((delta_t.embedding <=> '[2,2,2,2]'::vector))
                     ->  Sort
                           Output: delta_t.id, delta_t.n1, delta_t.n2, delta_t.n3, delta_t.n4, ((delta_t.embedding <=> '[2,2,2,2]'::vector))
                           Sort Key: ((delta_t.embedding <=> '[2,2,2,2]'::vector))
                           ->  Seq Scan on union_all_no_where_test.delta_t
                                 Output: delta_t.id, delta_t.n1, delta_t.n2, delta_t.n3, delta_t.n4, (delta_t.embedding <=> '[2,2,2,2]'::vector)
               ->  Limit
                     Output: s.id, s.n1, s.n2, s.n3, s.n4, ((s.embedding <=> '[2,2,2,2]'::vector))
                     ->  Nested Loop Anti Join
                           Output: s.id, s.n1, s.n2, s.n3, s.n4, ((s.embedding <=> '[2,2,2,2]'::vector))
                           Join Filter: (d.row_id = s.row_id)
