-- Cosine exercises the approximate-consumer gate. Do not relax the Result
-- whitelist to compensate for a missing branch-local scalar projection.
SET ann_orderby_distance_reuse = cosine;
SET enable_union_all_required_columns_pushdown = off;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT id,id,id,n1,n2,n3,n4 FROM union_view
ORDER BY embedding <=> '[2,2,2,2]'::vector LIMIT 100;
                                                                                             QUERY PLAN                                                                                              
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   Output: "*SELECT* 1".id, "*SELECT* 1".id, "*SELECT* 1".id, "*SELECT* 1".n1, "*SELECT* 1".n2, "*SELECT* 1".n3, "*SELECT* 1".n4, (("*SELECT* 1".embedding <=> '[2,2,2,2]'::vector))
   ->  Sort
         Output: "*SELECT* 1".id, "*SELECT* 1".id, "*SELECT* 1".id, "*SELECT* 1".n1, "*SELECT* 1".n2, "*SELECT* 1".n3, "*SELECT* 1".n4, (("*SELECT* 1".embedding <=> '[2,2,2,2]'::vector))
         Sort Key: (("*SELECT* 1".embedding <=> '[2,2,2,2]'::vector))
         ->  Result
               Output: "*SELECT* 1".id, "*SELECT* 1".id, "*SELECT* 1".id, "*SELECT* 1".n1, "*SELECT* 1".n2, "*SELECT* 1".n3, "*SELECT* 1".n4, ("*SELECT* 1".embedding <=> '[2,2,2,2]'::vector)
               ->  Append
                     ->  Subquery Scan on "*SELECT* 1"
                           Output: "*SELECT* 1".id, "*SELECT* 1".n1, "*SELECT* 1".n2, "*SELECT* 1".n3, "*SELECT* 1".n4, "*SELECT* 1".embedding
                           ->  Limit
                                 Output: delta_t.id, delta_t.embedding, delta_t.n1, delta_t.n2, delta_t.n3, delta_t.n4, delta_t.unused_text, ((delta_t.embedding <=> '[2,2,2,2]'::vector))
                                 ->  Sort
                                       Output: delta_t.id, delta_t.embedding, delta_t.n1, delta_t.n2, delta_t.n3, delta_t.n4, delta_t.unused_text, ((delta_t.embedding <=> '[2,2,2,2]'::vector))
                                       Sort Key: ((delta_t.embedding <=> '[2,2,2,2]'::vector))
                                       ->  Seq Scan on union_all_no_where_test.delta_t
                                             Output: delta_t.id, delta_t.embedding, delta_t.n1, delta_t.n2, delta_t.n3, delta_t.n4, delta_t.unused_text, (delta_t.embedding <=> '[2,2,2,2]'::vector)
                     ->  Subquery Scan on "*SELECT* 2"
                           Output: "*SELECT* 2".id, "*SELECT* 2".n1, "*SELECT* 2".n2, "*SELECT* 2".n3, "*SELECT* 2".n4, "*SELECT* 2".embedding
                           ->  Limit
                                 Output: s.id, s.embedding, s.n1, s.n2, s.n3, s.n4, s.unused_text, ((s.embedding <=> '[2,2,2,2]'::vector))
                                 ->  Nested Loop Anti Join
                                       Output: s.id, s.embedding, s.n1, s.n2, s.n3, s.n4, s.unused_text, (s.embedding <=> '[2,2,2,2]'::vector)
                                       Join Filter: (d.row_id = s.row_id)
                                       ->  Ann Index Scan using snapshot_cosine_idx on union_all_no_where_test.snapshot_t s
                                             Output: s.id, s.row_id, s.embedding, s.n1, s.n2, s.n3, s.n4, s.unused_text
                                             Order By: (s.embedding <=> '[2,2,2,2]'::vector)
                                       ->  Materialize
                                             Output: d.row_id
                                             ->  Index Only Scan using delete_row_id_idx on union_all_no_where_test.delete_t d
                                                   Output: d.row_id
(31 rows)

SET enable_union_all_required_columns_pushdown = on;
EXPLAIN (VERBOSE ON, COSTS OFF)
SELECT id,id,id,n1,n2,n3,n4 FROM union_view
ORDER BY embedding <=> '[2,2,2,2]'::vector LIMIT 100;
                                                                    QUERY PLAN                                                                     
---------------------------------------------------------------------------------------------------------------------------------------------------
