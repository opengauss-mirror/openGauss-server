\! echo "SELECT pg_listening_channels();"   >> @abs_bindir@/async_test.sql
\h listen
Command:     LISTEN
Description: register current session as a listener of certain notification channel
Syntax:
LISTEN channel;

\h notify
Command:     NOTIFY
Description: generate a notification
Syntax:
NOTIFY channel [ , payload ];

\h unlisten
Command:     UNLISTEN
Description: cancel the registration as a listener of certain notification channel(s)
Syntax:
UNLISTEN { channel | * };

-- throw warnings when async queue is half full
\! echo "LISTEN ch1;"                                                                       >> @abs_bindir@/async_test.sql
\! echo "BEGIN"                                                                             >> @abs_bindir@/async_test.sql
\! echo "  FOR i IN 0..33 LOOP"                                                             >> @abs_bindir@/async_test.sql
-- payload length is 19*421=7999
\! echo "    EXECUTE 'NOTIFY ch2, ' || quote_literal(repeat('line of length 19. ', 421));"  >> @abs_bindir@/async_test.sql
\! echo "    COMMIT;"                                                                       >> @abs_bindir@/async_test.sql
\! echo "  END LOOP;"                                                                       >> @abs_bindir@/async_test.sql
\! echo "END;"                                                                              >> @abs_bindir@/async_test.sql
\! echo "/"                                                                                 >> @abs_bindir@/async_test.sql
\! echo "UNLISTEN *;"                                                                       >> @abs_bindir@/async_test.sql
