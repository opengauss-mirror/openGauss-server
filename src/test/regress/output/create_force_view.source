CREATE DATABASE "force_view_dump" dbcompatibility = 'A';
CREATE DATABASE "force_view_restore" dbcompatibility = 'A';
CREATE USER test_force_view PASSWORD 'gauss;123' SYSADMIN;
\c force_view_dump
SET SESSION AUTHORIZATION test_force_view PASSWORD 'gauss;123';
CREATE VIEW v1_error AS select * from t1; 
