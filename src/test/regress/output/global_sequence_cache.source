CREATE TABLE employees_old1 ( emp_id INT PRIMARY KEY DEFAULT nextval('test_seq_old1'), emp_name VARCHAR(100) NOT NULL, department VARCHAR(50), hire_date DATE DEFAULT CURRENT_DATE, salary DECIMAL(10,2));
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "employees_old1_pkey" for table "employees_old1"
CREATE TABLE employees_old2 ( emp_id INT PRIMARY KEY DEFAULT nextval('test_seq_old2'), emp_name VARCHAR(100) NOT NULL, department VARCHAR(50), hire_date DATE DEFAULT CURRENT_DATE, salary DECIMAL(10,2));
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "employees_old2_pkey" for table "employees_old2"
INSERT INTO employees_old1 (emp_name, department, salary, hire_date)
SELECT 
    '员工' || n,
    CASE (n % 6)
        WHEN 0 THEN '技术部' WHEN 1 THEN '销售部'
        WHEN 2 THEN '市场部' WHEN 3 THEN '人事部'
        WHEN 4 THEN '财务部' WHEN 5 THEN '总裁办'
    END,
    8000.00 + (RANDOM() * 10000)::DECIMAL(10,2),
    CURRENT_DATE - (n * 10)
FROM generate_series(1,20) n;
INSERT INTO employees_old2 (emp_name, department, salary, hire_date)
SELECT 
    '员工' || n,
    CASE (n % 6)
        WHEN 0 THEN '技术部' WHEN 1 THEN '销售部'
        WHEN 2 THEN '市场部' WHEN 3 THEN '人事部'
        WHEN 4 THEN '财务部' WHEN 5 THEN '总裁办'
    END,
    8000.00 + (RANDOM() * 10000)::DECIMAL(10,2),
    CURRENT_DATE - (n * 10)
FROM generate_series(1,20) n;
