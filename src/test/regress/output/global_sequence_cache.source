select reset_global_seq.nextval;
 nextval 
---------
       2
(1 row)

select reset_global_seq.nextval;
 nextval 
---------
       3
(1 row)

select reset_global_seq.nextval;
 nextval 
---------
       4
(1 row)

alter sequence reset_global_seq
increment by 1 
minvalue 1 maxvalue 10
start 1
cycle
global
cache 3
restart;
NOTICE:  no changes needed for the cache level, "is_global" is already true .
drop sequence reset_global_seq;
