create large sequence reset_seq;
create table reset_seq_tab(a int default nextval('reset_seq'), b int,  c bigint default nextval('reset_seq'));
insert into reset_seq_tab(b) values (1);
insert into reset_seq_tab(b) values (1);
truncate reset_seq_tab;
drop table reset_seq_tab;
drop large sequence reset_seq;
-- 5 old version sequence and alter sequence test
create sequence test_seq_old1 start with 1 increment by 1 cache 20;
create large sequence test_seq_old2 start with 1 increment by 1 cache 20;
create sequence test_seq_1 start with 1 increment by 1 cache 20 global;
create large sequence test_seq_2 start with 1 increment by 1 cache 20 global;
-- 模拟老版本sequence
update pg_class set relkind='L' where relname='test_seq_old2';
update pg_class set relkind='S' where relname='test_seq_old1';
select relname, relkind, relnatts from pg_class where relname like 'test_seq_%' order by relname;
              relname              | relkind | relnatts 
-----------------------------------+---------+----------
 test_seq_1                        | z       |       12
