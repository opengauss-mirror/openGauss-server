-- 3.1 test of concurrent: continuity of sequence values
create table test_seqcache_for_parall(c1 integer, c2 integer);
create sequence seq_test_table increment by 1 start 1 no cycle cache 10 owned by test_seqcache_for_parall.c2;
-- insert data in parallel
create or replace procedure proc_for_para_seq() is 
begin 
    for i in 1 .. 10000 loop 
        insert into test_seqcache_for_parall values (i, nextval('seq_test_table')); 
    end loop; 
end;
