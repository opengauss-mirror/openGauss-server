\c regression
drop database test_db_b;
-- add Coverage 1 
create tablespace ts1 location '/tmp/ts1';
create tablespace ts2 location '/tmp/ts2';
create database test_db_ts tablespace ts1;
\c test_db_ts
create table tbl1(id bigserial PRIMARY KEY, data text) tablespace ts2;
