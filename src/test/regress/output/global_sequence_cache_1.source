-- ========================================
-- 1. D模式下的几个函数测试
-- ======================================== 
CREATE DATABASE compatible_db_d DBCOMPATIBILITY 'D';
\c compatible_db_d
create extension shark;
-- 1.1 普通序列
CREATE SEQUENCE pg_seq_params_seq1
    START 10
    INCREMENT 2
    MINVALUE 1
    MAXVALUE 100
    CACHE 5
    NO CYCLE
    GLOBAL;
NOTICE:  Not advised to use MAXVALUE or MINVALUE together with CACHE.
DETAIL:  If CACHE is defined, some sequence values may be wasted, causing available sequence numbers to be less than expected.
CREATE LARGE SEQUENCE pg_seq_params_seq2
    START 10
    INCREMENT 2
    MINVALUE 1
    MAXVALUE 100
    CACHE 5
    NO CYCLE
    SESSION;
NOTICE:  Not advised to use MAXVALUE or MINVALUE together with CACHE.
DETAIL:  If CACHE is defined, some sequence values may be wasted, causing available sequence numbers to be less than expected.
SELECT * FROM pg_sequence_all_parameters('pg_seq_params_seq1');
 start_value | minimum_value | maximum_value | increment | cycle_option | cache_size | last_value | is_called | log_cnt | uuid | last_used_value | is_exhausted 
-------------+---------------+---------------+-----------+--------------+------------+------------+-----------+---------+------+-----------------+--------------
          10 |             1 |           100 |         2 | f            |          5 |         10 | f         |       0 |    0 |                 | f
(1 row)

SELECT * FROM pg_sequence_all_parameters('pg_seq_params_seq2');
 start_value | minimum_value | maximum_value | increment | cycle_option | cache_size | last_value | is_called | log_cnt | uuid | last_used_value | is_exhausted 
-------------+---------------+---------------+-----------+--------------+------------+------------+-----------+---------+------+-----------------+--------------
          10 |             1 |           100 |         2 | f            |          5 |         10 | f         |       0 |    0 |                 | f
(1 row)

-- 清理 pg_sequence_all_parameters 相关
DROP SEQUENCE pg_seq_params_seq1;
DROP LARGE SEQUENCE pg_seq_params_seq2;
-- 4.2 若已加载 shark，可在 shark 测试 schema 中建表并调用（与 contrib/shark 用例一致）
-- 这里创建本地表并尝试调用，便于在安装 shark 的环境中覆盖
CREATE SCHEMA IF NOT EXISTS dbcc_coverage_schema;
CREATE SEQUENCE dbcc_coverage_schema.test_seq1
    START 10
    INCREMENT 2
    MINVALUE 1
    MAXVALUE 100
    CACHE 5
    NO CYCLE
    GLOBAL;
NOTICE:  Not advised to use MAXVALUE or MINVALUE together with CACHE.
DETAIL:  If CACHE is defined, some sequence values may be wasted, causing available sequence numbers to be less than expected.
CREATE LARGE SEQUENCE dbcc_coverage_schema.test_seq2
    START 10
    INCREMENT 2
    MINVALUE 1
    MAXVALUE 100
    CACHE 5
    NO CYCLE
    GLOBAL;
NOTICE:  Not advised to use MAXVALUE or MINVALUE together with CACHE.
DETAIL:  If CACHE is defined, some sequence values may be wasted, causing available sequence numbers to be less than expected.
CREATE TABLE dbcc_coverage_schema.ident_tab (id bigint PRIMARY KEY DEFAULT nextval('dbcc_coverage_schema.test_seq1'), name char);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "ident_tab_pkey" for table "ident_tab"
CREATE TABLE dbcc_coverage_schema.ident_tab1 (id bigint PRIMARY KEY DEFAULT nextval('dbcc_coverage_schema.test_seq2'), name char);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "ident_tab1_pkey" for table "ident_tab1"
INSERT INTO dbcc_coverage_schema.ident_tab(name) VALUES ('a'), ('b'), ('c');
INSERT INTO dbcc_coverage_schema.ident_tab1(name) VALUES ('a'), ('b'), ('c');
DO $$
BEGIN
    IF EXISTS (
        SELECT 1 FROM pg_proc p
        JOIN pg_namespace n ON p.pronamespace = n.oid
        WHERE n.nspname = 'sys' AND p.proname = 'dbcc_check_ident_reseed'
    ) THEN
        PERFORM sys.dbcc_check_ident_reseed('dbcc_coverage_schema.ident_tab', 100::bigint, true);
        PERFORM sys.dbcc_check_ident_reseed('dbcc_coverage_schema.ident_tab', 50::bigint, false);
        PERFORM sys.dbcc_check_ident_reseed('dbcc_coverage_schema.ident_tab1', 100::int16, true);
        PERFORM sys.dbcc_check_ident_reseed('dbcc_coverage_schema.ident_tab1', 50::int16, false);
    END IF;
EXCEPTION
    WHEN OTHERS THEN
        NULL;
END;
$$;
NOTICE:  "Checking identity information: current identity value '100'."
CONTEXT:  referenced column: dbcc_check_ident_reseed
SQL statement "SELECT sys.dbcc_check_ident_reseed('dbcc_coverage_schema.ident_tab', 50::bigint, false)"
PL/pgSQL function inline_code_block line 9 at PERFORM
NOTICE:  "Checking identity information: current identity value '100'."
CONTEXT:  referenced column: dbcc_check_ident_reseed
SQL statement "SELECT sys.dbcc_check_ident_reseed('dbcc_coverage_schema.ident_tab1', 50::int16, false)"
PL/pgSQL function inline_code_block line 11 at PERFORM
-- copy identity(start/increment) of source table in SELECT INTO clause for D format
CREATE TABLE tbl_identity (id bigint identity(1,1), name VARCHAR(100));
NOTICE:  CREATE TABLE will create implicit sequence "tbl_identity_id_seq_identity" for serial column "tbl_identity.id"
select * into tbl1 from tbl_identity where id % 2 != 0;
NOTICE:  CREATE TABLE will create implicit sequence "tbl1_id_seq_identity" for serial column "tbl1.id"
ERROR:  Cannot insert identity column "id"
LINE 1: select * into tbl1 from tbl_identity where id % 2 != 0;
                                       ^
drop table tbl_identity cascade;
DROP SCHEMA dbcc_coverage_schema cascade;
NOTICE:  drop cascades to 4 other objects
DETAIL:  drop cascades to sequence dbcc_coverage_schema.test_seq1
drop cascades to large sequence dbcc_coverage_schema.test_seq2
drop cascades to table dbcc_coverage_schema.ident_tab
drop cascades to table dbcc_coverage_schema.ident_tab1
\c regression
DROP DATABASE compatible_db_d;
-- ========================================
-- 2. publication_deparse_table_rewrite()
-- 仅在 table_rewrite 事件触发器内调用，对支持 DDL 复制的表进行 deparse 并记录
-- 通过：创建 publication(with ddl) -> 建表 -> 执行触发 table_rewrite 的 ALTER
-- ========================================
-- 2.1 直接调用会报错（非事件触发器上下文），捕获错误以便脚本继续
DO $$
BEGIN
    PERFORM publication_deparse_table_rewrite();
EXCEPTION WHEN OTHERS THEN
    RAISE NOTICE 'expected: not fired by event trigger manager';
END;
$$;
NOTICE:  expected: not fired by event trigger manager
-- 2.2 通过 publication + table_rewrite 触发
CREATE SEQUENCE test_seq1
    START 10
    INCREMENT 2
    MINVALUE 1
    MAXVALUE 100
    CACHE 5
    NO CYCLE
    GLOBAL;
NOTICE:  Not advised to use MAXVALUE or MINVALUE together with CACHE.
DETAIL:  If CACHE is defined, some sequence values may be wasted, causing available sequence numbers to be less than expected.
create large sequence test_large_seq1 global;
CREATE TABLE rewrite_tab (a int PRIMARY KEY DEFAULT nextval('test_seq1'), b char);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "rewrite_tab_pkey" for table "rewrite_tab"
INSERT INTO rewrite_tab(b) VALUES ('x'), ('y'), ('z');
CREATE TABLE rewrite_tab1 (a int PRIMARY KEY DEFAULT nextval('test_large_seq1'), b char);
NOTICE:  CREATE TABLE / PRIMARY KEY will create implicit index "rewrite_tab1_pkey" for table "rewrite_tab1"
INSERT INTO rewrite_tab1(b) VALUES ('x'), ('y'), ('z');
-- 创建带 DDL 的 publication，会注册 table_rewrite 等事件触发器
CREATE PUBLICATION pub_deparse_rewrite FOR ALL TABLES WITH (ddl = 'table');
WARNING:  wal_level is insufficient to publish logical changes
HINT:  Set wal_level to logical before creating subscriptions.
-- 执行会触发 table_rewrite 的 ALTER（例如改列类型导致重写）
alter sequence test_seq1 session;
alter sequence test_seq1 global;
alter sequence if exists test_seq1 session;
alter sequence if exists test_seq1 global;
alter large sequence test_large_seq1 session;
alter large sequence test_large_seq1 global;
alter large sequence if exists test_large_seq1 session;
alter large sequence if exists test_large_seq1 global;
create sequence test_seq_1 start with 1 increment by 1 cache 20 global;
create large sequence test_seq_2 start with 1 increment by 1 cache 20 global;
alter extension hstore add sequence test_seq1;
ERROR:  EXTENSION is not yet supported.
alter extension hstore drop sequence test_seq1;
ERROR:  EXTENSION is not yet supported.
SECURITY LABEL ON sequence test_seq IS 'classified';
ERROR:  SECURITY LABEL is not yet supported.
alter sequence test_seq1 RENAME TO test_seq1_new;
alter sequence if exists test_seq1_new RENAME TO test_seq1;
alter large sequence test_large_seq1 RENAME TO test_large_seq1_new;
alter large sequence if exists test_large_seq1_new RENAME TO test_large_seq1;
create schema test_sch;
alter sequence test_seq_1 set SCHEMA test_sch;
ERROR:  ALTER SEQUENCE SET SCHEMA is not yet supported.
alter sequence if exists test_seq_1 set SCHEMA test_sch;
ERROR:  ALTER SEQUENCE SET SCHEMA is not yet supported.
alter large sequence test_seq_2 set SCHEMA test_sch;
ERROR:  ALTER SEQUENCE SET SCHEMA is not yet supported.
alter large sequence if exists test_seq_2 set SCHEMA test_sch;
ERROR:  ALTER SEQUENCE SET SCHEMA is not yet supported.
drop schema test_sch;
drop sequence test_seq_1;
drop large sequence test_seq_2;
-- 再执行一种会触发 rewrite 的变更（如设 NOT NULL + 默认值导致重写，视实现而定）
-- ALTER TABLE rewrite_tab ALTER COLUMN b SET NOT NULL;
-- 清理
DROP PUBLICATION pub_deparse_rewrite;
DROP TABLE rewrite_tab;
DROP TABLE rewrite_tab1;
DROP SEQUENCE test_seq1;
DROP LARGE SEQUENCE test_large_seq1;
